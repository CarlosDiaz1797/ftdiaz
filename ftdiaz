  .go { width: 44px; height: 44px; right: 28px; bottom: 26px; }
  .clouds.back { --ch: 40vh; } .clouds.front { --ch: 30vh; }
  .panel-hero { margin: -34px -20px 20px; }
  .panel-hero-text { left: 20px; bottom: 24px; }
  .snav { left: 12px; right: 12px; transform: translateY(-140%); justify-content: space-between; }
  .snav.show { transform: none; }
  .snav a { padding: 8px 9px; font-size: 9px; letter-spacing: .08em; }
  .dots button { padding: 8px 10px 11px; font-size: 9px; letter-spacing: .12em; }
  .dots { margin-top: 84px !important; }
  .dots button[aria-current="true"]::after { left: 10px; right: 10px; }
  .flip { right: 26px; top: 20px; width: 32px; height: 32px; font-size: 15px; }
  .back { padding: 22px 28px; gap: 8px; }
  .back ul { gap: 5px; margin: 0 0 4px; }
  .back li { font-size: 12px; padding-left: 24px; }
  .back li::before { width: 16px; height: 16px; font-size: 9px; }
  .back .btn { padding: 9px 13px; font-size: 9px; }
  .planet { left: 6%; top: 11%; }
  .calc, .bodymap { grid-template-columns: minmax(0, 1fr); padding: 20px; }
  .quiz { padding: 22px; }
  .mega-grid { grid-template-columns: 1fr; }
  .mega-panel { right: 8px; left: 8px; width: auto; }
  .sec-index span { width: 100%; }
  .meet-row { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 8px; }
  .meet-card { flex: 0 0 72%; scroll-snap-align: start; }
  .snav-hi { display: none !important; }
  .calc-tabs [role="tab"] { font-size: 12px; padding: 10px 14px; }
  .why3-grid, .values, .how-steps, .promises ul { grid-template-columns: 1fr; }
  .tell { padding: 18px; }
  .tell-head { align-items: flex-start; }
  .tell-av { width: 50px; height: 50px; }
  .story { gap: 26px; padding-top: 8vh; }
  .real-grid { grid-template-columns: minmax(0, 1fr); gap: 20px; }
  .people { padding: 16px; }
  .stat-row { grid-template-columns: 1fr; }
  .fami { padding: 18px; }
  .flabel { font-size: 20px; } .frole { font-size: 15px; } .flabel.me { font-size: 18px; }
  .timeline { grid-template-columns: 1fr; }
  .myths { grid-template-columns: 1fr; }
  .myth { min-height: 200px; }
  .scenario { padding: 18px; }
  .sound-lbl { display: none; }
  .sound-btn { left: 16px; padding: 0 12px; }
  .node small { display: none; }
  .node span { font-size: 15px; }
