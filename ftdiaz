const LITE_REASONS = [
  matchMedia('(pointer: coarse)').matches && Math.min(screen.width, screen.height) < 820,
  (navigator.hardwareConcurrency || 8) <= 4,
  (navigator.deviceMemory || 8) <= 4,
  !!(navigator.connection && navigator.connection.saveData)
];
