  .feature, .feature.reverse { grid-template-columns: minmax(0, 1fr); grid-template-areas: "head" "media" "text"; row-gap: 24px; padding: 10vh 0 4vh; }
  .feature.reverse .feature-head { text-align: left; }
  .feature .big { font-size: 9vw; overflow-wrap: anywhere; }   /* "REHABILITACIÓN" cabe completo en celular */
  .about-section { grid-template-columns: minmax(0, 1fr); gap: 28px; padding: 10vh 0 4vh; }
  .statement { padding: 12vh 6vw 8vh; }
  .statement h2 { font-size: 17vw; }
  footer .sep { display: none; }

  #panelContent { padding: 34px 20px; }
  .panel h2 { font-size: 34px; }
  .close { top: 10px; right: 10px; }
}

/* Quien tenga activado "reducir movimiento" ve todo sin animación */
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { animation: none !important; transition: none !important; }
  .reveal, .statement span, .about-photo { opacity: 1 !important; transform: none !important; filter: none !important; }
  .statement span { --f: 1; }
  .card.flipping { rotate: none; }
  .wa-fab { opacity: 1; transform: none; pointer-events: auto; }
  .feature-media { clip-path: none !important; }
}

/* Aviso de pago recibido */
.pago-ok { text-align: center; padding: 36px 8px 12px; }
.pago-ok h2 { margin: 6px 0 10px; }
.pago-ok .panel-intro { margin-left: auto; margin-right: auto; max-width: 520px; }
.pago-ok small { color: var(--muted); font-size: 12px; word-break: break-all; }
.pago-check { width: 72px; height: 72px; margin: 0 auto 14px; border-radius: 50%; display: grid; place-items: center; font-size: 34px; color: #fff; background: radial-gradient(circle at 50% 35%, #3f8ce8, #0b2a66); box-shadow: 0 0 30px rgba(80, 170, 255, .55); }

/* ===== Sobre mí: la historia se ilumina al bajar ===== */
.story-line.js::before { opacity: .18; }
.story-line::after {
  content: ''; position: absolute; left: 6px; top: 6px; width: 2px; border-radius: 2px;
  height: calc((100% - 12px) * var(--p, 0));
  background: linear-gradient(180deg, #ff5a78, #4f9bff 70%, #e8c67a);
  box-shadow: 0 0 10px rgba(141, 218, 255, .9), 0 0 22px rgba(255, 90, 120, .45);
  transition: height .18s linear;
}
.story-line li { transition: opacity .7s ease, filter .7s ease; }
.story-line.js li.reveal.in:not(.lit) { opacity: .28; filter: saturate(.2) blur(.4px); }
.story-line li::before { transition: transform .5s cubic-bezier(.2, .8, .2, 1), box-shadow .5s, border-color .5s; }
.story-line li.lit::before { transform: scale(1.2); border-color: #fff; box-shadow: 0 0 6px #fff, 0 0 20px #8ddaff; }
.story-line li.coma.lit::before { border-color: #ff5a78; box-shadow: 0 0 6px #fff, 0 0 22px #ff5a78; animation: latido 1.1s ease-in-out infinite; }
.story-line li.coma.lit b { color: #ff8fa3; }
.story-line li.now.lit::before { box-shadow: 0 0 8px #fff1c4, 0 0 26px #e8c67a; }
.story-line li.now.lit span { text-shadow: 0 0 22px rgba(232, 198, 122, .45); }
@keyframes latido { 0%, 100% { transform: scale(1.1); } 14% { transform: scale(1.45); } 28% { transform: scale(1.1); } 42% { transform: scale(1.35); } 60% { transform: scale(1.1); } }
.ecg { width: min(240px, 100%); height: 38px; margin-top: 6px; overflow: visible; }
.ecg path { fill: none; stroke: #ff5a78; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 100; stroke-dashoffset: 100; filter: drop-shadow(0 0 4px #ff5a78); opacity: .35; }
.story-line li.coma.lit .ecg path { opacity: 1; animation: ecg 2.2s linear infinite; }
@keyframes ecg { 0% { stroke-dashoffset: 100; } 55% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: -100; } }
@media (prefers-reduced-motion: reduce) {
  .story-line li.coma.lit::before { animation: none; }
  .story-line li.coma.lit .ecg path { animation: none; stroke-dashoffset: 0; }
}

/* ---- La realidad en pilares ---- */
.pillars { width: 100%; max-width: 1100px; margin-left: auto; margin-right: auto; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 22px); align-items: start; margin-top: 8px; margin-bottom: 0; }
.pillar { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 12px; }
.pillar > b { height: 64px; display: flex; align-items: flex-end; justify-content: center; font-size: clamp(30px, 3.2vw, 48px); font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; color: #fff; }
.pillar > b.m::after { content: 'M'; margin-left: .18em; font-size: .5em; color: var(--muted); }
.pillar.red > b { color: #ff7d93; text-shadow: 0 0 18px rgba(255, 90, 120, .5); }
.pillar.gold > b, .pillar.live > b { background: linear-gradient(120deg, #fff1c4, #e8c67a 45%, #c9953c); -webkit-background-clip: text; background-clip: text; color: transparent; }
.pillar.live > b { font-size: clamp(20px, 1.9vw, 30px); padding-bottom: 6px; }
.pillar small { font-size: 13px; line-height: 1.5; color: var(--soft); max-width: 190px; }
.pillar small strong { color: #fff; }
/* la columna: cristal con capitel y base */
.col { position: relative; width: min(100%, 118px); height: clamp(200px, 26vw, 300px); border-radius: 16px 16px 6px 6px; overflow: hidden;
  background: linear-gradient(90deg, rgba(141, 218, 255, .05), rgba(141, 218, 255, .14) 45%, rgba(141, 218, 255, .04));
  border: 1px solid rgba(141, 218, 255, .28); box-shadow: inset 0 0 22px rgba(80, 170, 255, .12); }
.col::before, .col::after { content: ''; position: absolute; left: -6px; right: -6px; height: 10px; border-radius: 4px; background: rgba(141, 218, 255, .22); border: 1px solid rgba(141, 218, 255, .35); z-index: 2; }
.col::before { top: -1px; } .col::after { bottom: -1px; }
.liq { position: absolute; left: 0; right: 0; bottom: 0; height: 0; transition: height 1.8s cubic-bezier(.2, .8, .2, 1); }
.pillar.red .liq { background: linear-gradient(180deg, #ff5a78, #7a1830); box-shadow: 0 0 26px rgba(255, 90, 120, .55); }
.pillar.gold .liq { background: linear-gradient(180deg, #fff1c4, #c9953c); box-shadow: 0 0 26px rgba(232, 198, 122, .6); transition-delay: .5s; }
.liq::before { content: ''; position: absolute; left: 0; right: 0; top: -4px; height: 8px; border-radius: 50%; background: rgba(255, 255, 255, .55); filter: blur(2px); }
.pillars.filled .liq { height: calc(var(--fill) * 1%); }
.lvl { position: absolute; left: 0; right: 0; bottom: 14px; z-index: 3; font-size: 13px; font-weight: 700; letter-spacing: .1em; color: #fff; opacity: 0; transition: opacity .6s 1.6s; }
.pillars.filled .lvl { opacity: 1; }
.beam { position: absolute; inset: 0; overflow: hidden; }
.beam::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 60%; background: linear-gradient(180deg, transparent 0%, rgba(141, 218, 255, .35) 50%, transparent 100%); animation: beamUp 3.4s linear infinite; will-change: transform; }
.pillar.live .beam::before { background: linear-gradient(180deg, transparent 0%, rgba(232, 198, 122, .45) 50%, transparent 100%); }
@keyframes beamUp { from { transform: translateY(170%); } to { transform: translateY(-100%); } }
.pico { position: absolute; left: 0; right: 0; top: 50%; translate: 0 -50%; z-index: 3; font-size: 30px; color: rgba(232, 244, 255, .7); }
.pillar.live .col { border-color: rgba(232, 198, 122, .45); }
.real-ask { width: 100%; max-width: 760px; margin: 34px auto 0; text-align: center; display: flex; flex-direction: column; gap: 14px; align-items: center; }
.real-ask .real-answers { justify-content: center; }
@media (max-width: 1100px) { .pillars { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
@media (max-width: 700px) { .pillars { grid-template-columns: repeat(2, minmax(0, 1fr)); } .pillar.live { grid-column: 1 / -1; } .col { height: 170px; } }
@media (prefers-reduced-motion: reduce) { .beam::before { animation: none; opacity: 0; } .liq, .lvl { transition: none; } }

/* =========================================================
   MODO LIGERO (celulares y equipos modestos): mismos colores,
   pero sin los efectos que más cuestan al procesador y a la tarjeta de video.
   ========================================================= */
html.lite *, html.lite *::before, html.lite *::after { -webkit-backdrop-filter: none !important; backdrop-filter: none !important; }
html.lite .nebula-img, html.lite .milkyway, html.lite .nebula, html.lite .glow-red, html.lite .planet img { animation: none !important; }
html.lite .nebula, html.lite .glow-red, html.lite .clouds, html.lite .tint { mix-blend-mode: normal; }
html.lite .nebula { filter: blur(30px); opacity: .7; }
html.lite .milkyway { filter: blur(20px); }
html.lite .glow-red { filter: blur(34px); }
html.lite .clouds.red { display: none; }
html.lite .parallax { transition: none; }
html.lite .deck.moving .card { filter: none; }
html.lite .snav, html.lite .bot, html.lite .mega-panel, html.lite .panel { background-color: rgba(3, 14, 36, .94); }

/* Navegadores anteriores a 2022 (sin la propiedad "translate"): mismas posiciones con transform */
@supports not (translate: 0) {
  .node { transform: translate(-50%, -50%); }
  .n-strategy { transform: translate(-50%, calc(-100% + 11px)); }
  .n-rehab, .n-wellness { transform: translate(-50%, -11px); }
  .const-center { transform: translate(-50%, -50%); }
  .pico { transform: translateY(-50%); }
  .bot-teaser { transform: translateY(-50%); }
}

/* ---- Testimonios ---- */
.testi-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(14px, 2vw, 26px); margin-top: 8px; }
.testi-card { margin: 0; display: flex; flex-direction: column; border-radius: 24px; overflow: hidden;
  background: linear-gradient(160deg, rgba(14, 44, 100, .55), rgba(3, 12, 32, .8)); border: 1px solid rgba(141, 218, 255, .25);
  box-shadow: 0 18px 40px rgba(0, 0, 0, .35); transition: transform .4s cubic-bezier(.2, .8, .2, 1), border-color .4s, box-shadow .4s; }
.testi-card img { width: 100%; aspect-ratio: 4 / 4.2; height: auto; object-fit: cover; object-position: 50% 22%; display: block;
  -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent); mask-image: linear-gradient(to bottom, #000 72%, transparent); }
.testi-card blockquote { position: relative; margin: -18px 22px 0; padding-top: 26px; font-family: 'Playfair Display', serif; font-size: clamp(17px, 1.45vw, 20px); line-height: 1.45; color: #fff; flex: 1; }
.testi-card blockquote::before { content: '“'; position: absolute; left: -4px; top: -18px; font-size: 64px; line-height: 1; color: #8ddaff; opacity: .55; }
.testi-card figcaption { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 18px 22px 22px; }
.testi-card figcaption b { font-size: 15px; letter-spacing: .06em; }
.testi-tag { font-size: 10px; letter-spacing: .22em; text-transform: uppercase; padding: 6px 10px; border-radius: 999px; color: #cfe8ff; border: 1px solid rgba(79, 155, 255, .55); background: rgba(47, 138, 255, .14); }
@media (hover: hover) { .testi-card:hover { transform: translateY(-6px); border-color: rgba(141, 218, 255, .55); box-shadow: 0 24px 50px rgba(0, 0, 0, .4), 0 0 26px rgba(80, 170, 255, .2); } }
@media (max-width: 900px) {
  .testi-row { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 78%; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 10px; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
  .testi-row::-webkit-scrollbar { display: none; }
  .testi-card { scroll-snap-align: center; }
}
