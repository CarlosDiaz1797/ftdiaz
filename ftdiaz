/* =========================================================
   FONDO ESPACIAL
   ========================================================= */
.space {
  position: fixed; inset: 0; z-index: 0; overflow: hidden;
  background: #01060f;
}
/* Nebulosa azul con planeta: se acerca y se desplaza muy despacio */
.nebula-img {
  position: absolute; inset: -5%;
  background: url('assets/nebula-azul.jpg') center / cover no-repeat;
  filter: saturate(1.3) brightness(1.15);
  animation: drift 80s ease-in-out infinite alternate;
  will-change: transform;
}
/* Nubes que pasan lento pero constante por la parte de abajo.
   La imagen de nubes se repite sin cortes (proporción 4.8 : 1). */
.clouds {
  position: absolute; left: 0;
  height: var(--ch); width: calc(var(--ch) * 4.8 * 3);
  background: url('assets/nubes-azul.jpg') left bottom / auto 100% repeat-x;
  mix-blend-mode: screen;
  -webkit-mask-image: linear-gradient(to top, #000 50%, transparent);
  mask-image: linear-gradient(to top, #000 50%, transparent);
  animation: clouds var(--t) linear infinite;
  will-change: transform;
}
.clouds.back  { --ch: 64vh; --t: 240s; bottom: 6vh;  opacity: .5; }
.clouds.front { --ch: 48vh; --t: 140s; bottom: -10vh; opacity: .75; }
/* Nubes rojas muy sutiles que van en sentido contrario */
.clouds.red   { --ch: 56vh; --t: 320s; bottom: -4vh; opacity: .26; animation-direction: reverse; background-image: url('assets/nubes-roja.jpg'); }
/* Resplandores rojos que flotan despacio */
.glow-red { position: absolute; border-radius: 50%; mix-blend-mode: screen; filter: blur(70px); will-change: transform; }
.g1 { width: 38vw; height: 26vw; right: -6vw; bottom: 4vh; background: rgba(220, 35, 70, .30); animation: float2 26s ease-in-out infinite alternate; }
.g2 { width: 26vw; height: 18vw; left: 8vw; top: 30vh; background: rgba(200, 30, 60, .18); animation: float3 32s ease-in-out infinite alternate; }
/* Planeta: viaja, crece y gira mientras bajas por la página */
.planet {
  position: absolute; left: 13%; top: 15%; width: clamp(80px, 8.5vw, 170px); aspect-ratio: 1; pointer-events: none;
  transform: translate(calc(var(--sp, 0) * 48vw), calc(var(--sp, 0) * 42vh)) scale(calc(1 + var(--sp, 0) * .7));
  filter: drop-shadow(0 0 22px rgba(80, 160, 255, .45));
  will-change: transform;
}
.planet img { display: block; width: 100%; height: 100%; rotate: calc(var(--sp, 0) * 160deg); animation: spin 200s linear infinite; }

/* Capa que se mueve con el mouse (efecto de profundidad) */
.parallax {
  position: absolute; inset: -6%; opacity: .6;
  transform: translate3d(var(--px, 0px), var(--py, 0px), 0);
  transition: transform 1.2s cubic-bezier(.2, .8, .2, 1);
  will-change: transform;
}
/* Vía láctea diagonal */
.milkyway {
  position: absolute; left: -10%; top: 4%; width: 125%; height: 42%;
  transform: rotate(-12deg);
  background:
    radial-gradient(ellipse 30% 45% at 22% 55%, rgba(140, 110, 255, .38), transparent 70%),
    radial-gradient(ellipse 35% 50% at 50% 45%, rgba(80, 150, 255, .42), transparent 70%),
