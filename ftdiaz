.snav a.on { color: #fff; background: linear-gradient(120deg, rgba(43, 109, 255, .55), rgba(141, 218, 255, .25)); box-shadow: inset 0 0 0 1px rgba(141, 218, 255, .45), 0 0 16px rgba(80, 170, 255, .35); }
.snav .progress { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: rgba(141, 218, 255, .1); }
.snav .progress i { display: block; height: 100%; transform-origin: left; transform: scaleX(0); background: linear-gradient(90deg, #8ddaff, #2b5dff 60%, var(--red)); box-shadow: 0 0 8px rgba(141, 218, 255, .8); }
@media (hover: hover) { }
html.modal-open .wa-fab, html.modal-open .snav { opacity: 0; pointer-events: none; }

/* =========================================================
   1. INICIO (CARRUSEL)
   ========================================================= */
.hero {
  min-height: calc(100vh - clamp(68px, 12vh, 118px) - 14px);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 0 2.5vw 28px;
}
.intro { text-align: center; margin: -10px 0 8px; }
.intro h1 { font-family: 'Playfair Display', serif; font-size: clamp(26px, 3.4vw, 50px); margin: 0 0 4px; line-height: 1.15; }
.intro em { font-style: normal; color: var(--cyan); }
.lead { margin: 0; color: #aac6e2; font-size: 13px; letter-spacing: .14em; }

.deck-area { width: min(1540px, 96vw); position: relative; overflow-x: clip; }
.deck {
  position: relative; z-index: 1;
  width: 100%; height: var(--deck-h);
  perspective: 1700px; touch-action: pan-y;
  user-select: none; -webkit-user-select: none;
}

.card {
  position: absolute; top: 50%; left: 50%;
  width: var(--card-w); aspect-ratio: 21.59 / 13.97;
  overflow: hidden; border-radius: 36px;
  background: #07203f;
  -webkit-mask-image: var(--feather); mask-image: var(--feather);
  -webkit-mask-composite: source-in; mask-composite: intersect;
  transform: translate(-50%, -50%);
  translate: var(--dx, 0px) 0;   /* se mueve con el dedo mientras arrastras */
  transition: transform .65s cubic-bezier(.2, .8, .2, 1), translate .55s cubic-bezier(.2, .8, .2, 1), opacity .65s, filter .35s, rotate .3s ease-out;
  rotate: y 0deg;
  cursor: pointer;
}
.deck.dragging .card { transition: transform .65s cubic-bezier(.2, .8, .2, 1), translate 0s, opacity .65s, filter .35s; cursor: grabbing; }
.deck { --dx: 0px; }
/* Posiciones (las asigna script.js) */
.card[data-pos="center"] {
  transform: translate(-50%, -50%) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) scale(1);
  opacity: 1; z-index: 5; filter: none;
}
.card[data-pos="left"]  { transform: translate(-72%, -50%) scale(.84) rotateY(12deg);  opacity: .72; z-index: 2; filter: saturate(.85) brightness(.8); }
.card[data-pos="right"] { transform: translate(-28%, -50%) scale(.84) rotateY(-12deg); opacity: .72; z-index: 2; filter: saturate(.85) brightness(.8); }
/* Inclinación 3D siguiendo el mouse (tarjeta del centro) */
.card.tilt { transition: transform .18s ease-out, opacity .65s, filter .35s, rotate .3s ease-out; }

/* 1. Tarjeta que se voltea */
.card.flipping { rotate: y 90deg; transition: rotate .26s ease-in, transform .65s cubic-bezier(.2, .8, .2, 1), opacity .65s, filter .35s; }
.flip {
  position: absolute; z-index: 10; right: 54px; top: 38px;
  width: 38px; height: 38px; border-radius: 50%; padding: 0; cursor: pointer;
  display: grid; place-items: center; color: #fff;
  font: italic 700 17px/1 'Playfair Display', serif;
  background: rgba(2, 12, 30, .55); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
  border: 1px solid color-mix(in srgb, var(--acc) 70%, white);
  box-shadow: 0 0 14px color-mix(in srgb, var(--acc) 55%, transparent);
  transition: transform .3s, background .3s;
}
.card:not([data-pos="center"]) .flip { opacity: 0; pointer-events: none; }
@media (hover: hover) { .flip:hover { transform: scale(1.12); background: color-mix(in srgb, var(--acc) 30%, rgba(2, 12, 30, .6)); } }
.back {
  position: absolute; inset: 0; z-index: 11;
  display: flex; flex-direction: column; justify-content: center; gap: 12px;
  padding: 44px 64px;
  background:
    radial-gradient(ellipse 70% 60% at 85% 20%, color-mix(in srgb, var(--acc) 30%, transparent), transparent 70%),
    linear-gradient(150deg, rgba(10, 32, 78, .97), rgba(2, 9, 26, .98));
  visibility: hidden; opacity: 0;
}
.card.show-back .back { visibility: visible; opacity: 1; }
.card.show-back .flip { opacity: 0; pointer-events: none; }
.back h3 { margin: 0; font-family: 'Playfair Display', serif; font-size: clamp(28px, 3vw, 46px); line-height: 1; }
.back ul { list-style: none; margin: 4px 0 8px; padding: 0; display: grid; gap: 9px; }
.back li { position: relative; padding-left: 28px; font-size: clamp(13px, 1.1vw, 16px); color: #dcecff; }
.back li::before {
  content: '✓'; position: absolute; left: 0; top: 0; width: 19px; height: 19px; border-radius: 50%;
  display: grid; place-items: center; font-size: 11px; font-weight: 700; color: #04122c;
  background: var(--acc); box-shadow: 0 0 10px var(--acc);
}
.card.show-back .back > * { animation: rise .5s cubic-bezier(.2, .8, .2, 1) both; }
.card.show-back .back > *:nth-child(2) { animation-delay: .06s; }
.card.show-back .back > *:nth-child(3) { animation-delay: .12s; }
.card.show-back .back > *:nth-child(4) { animation-delay: .18s; }

/* 3. Tarjetas laterales que se asoman al pasar el mouse */
@media (hover: hover) and (min-width: 701px) {
  .card[data-pos="left"]:hover  { transform: translate(-76%, -50%) scale(.88) rotateY(6deg);  opacity: .95; filter: saturate(1) brightness(1); }
  .card[data-pos="right"]:hover { transform: translate(-24%, -50%) scale(.88) rotateY(-6deg); opacity: .95; filter: saturate(1) brightness(1); }
}
/* Desenfoque de movimiento al girar */
.deck.moving .card { filter: blur(5px) brightness(1.1); }

/* Capas de la tarjeta */
.card .visual { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s cubic-bezier(.2, .8, .2, 1); }
.card[data-pos="center"]:hover .visual { transform: scale(1.05); }
.shade {
  position: absolute; inset: 0; z-index: 1;
  background:
    linear-gradient(to top, rgba(2, 10, 30, .94) 0%, rgba(2, 10, 30, .5) 36%, rgba(2, 10, 30, .05) 68%),
    linear-gradient(135deg, rgba(40, 110, 255, .22), transparent 60%);
}
.shine { position: absolute; inset: -20%; z-index: 5; pointer-events: none; background: linear-gradient(115deg, transparent 42%, rgba(255, 255, 255, .16) 48%, transparent 54%); transform: translateX(-70%); animation: shine 8s ease-in-out infinite; }

.partner { position: absolute; z-index: 7; left: 54px; top: 40px; max-width: 230px; max-height: 76px; display: flex; align-items: center; }
.partner img { max-width: 220px; max-height: 70px; object-fit: contain; filter: drop-shadow(0 2px 10px rgba(0, 0, 0, .6)); }

.copy { position: absolute; z-index: 7; left: 58px; bottom: 50px; right: 140px; }
.copy h2 { font-family: 'Playfair Display', serif; font-size: clamp(30px, 3.8vw, 60px); line-height: 1; margin: 0 0 8px; text-shadow: 0 4px 24px rgba(0, 0, 0, .6); }
.copy p { margin: 0; font-size: 12px; letter-spacing: .34em; color: #d9e9f8; }

/* Botón redondo con flecha (como en el diseño) */
.go {
  position: absolute; z-index: 8; right: 54px; bottom: 48px;
  width: 58px; height: 58px; border-radius: 50%;
  border: 0; background: radial-gradient(circle at 50% 30%, rgba(60, 120, 220, .45), rgba(2, 10, 28, .75) 70%);
  display: grid; place-items: center; cursor: pointer;
  box-shadow: 0 0 18px rgba(90, 180, 255, .55), inset 0 0 12px rgba(120, 200, 255, .25);
  transition: transform .3s, background .3s;
}
.go svg { width: 22px; height: 22px; fill: none; stroke: #fff; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
@media (hover: hover) { .go:hover { transform: scale(1.08); background: rgba(95, 193, 255, .22); } }

/* Flechas laterales: botones flotantes de cristal, discretos, con esquinas suaves.
   El botón queda fijo (fácil de tocar) y lo que flota es su cristal y la flecha. */
.nav {
  position: absolute; z-index: 10; top: 50%; transform: translateY(-50%);
  width: 46px; height: 46px; padding: 0; border: 0; background: none;
  display: grid; place-items: center; cursor: pointer; color: #fff; isolation: isolate;
  opacity: .72; transition: opacity .3s;
  --float: navFloat 4.5s ease-in-out infinite;
}
.nav::before {
  content: ''; position: absolute; inset: 0; z-index: -1; border-radius: 16px;
  background: rgba(8, 24, 60, .38);
  border: 1px solid rgba(141, 218, 255, .22);
  -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, .35), inset 0 1px 0 rgba(255, 255, 255, .08);
  animation: var(--float);
  transition: background .3s, border-color .3s, box-shadow .3s;
}
.nav.left { left: 18px; }
.nav.right { right: 18px; }
.nav.right::before, .nav.right svg { animation-delay: -2.25s; }
@keyframes navFloat { 0%, 100% { translate: 0 0; } 50% { translate: 0 -6px; } }
.nav svg { width: 18px; height: 18px; fill: none; stroke: #e8f4ff; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; animation: var(--float); transition: transform .3s; }
@media (hover: hover) {
  .nav:hover { opacity: 1; }
  .nav:hover::before { background: rgba(20, 60, 140, .55); border-color: rgba(141, 218, 255, .6); box-shadow: 0 8px 28px rgba(0, 0, 0, .35), 0 0 18px rgba(90, 180, 255, .45); }
  .nav.left:hover svg { transform: translateX(-2px); }
  .nav.right:hover svg { transform: translateX(2px); }
}
.nav:active::before { background: rgba(214, 40, 57, .35); border-color: rgba(255, 120, 130, .6); }
.nav:focus-visible { outline: 2px solid #8ddaff; outline-offset: 3px; border-radius: 16px; opacity: 1; }
@media (prefers-reduced-motion: reduce) { .nav::before, .nav svg { animation: none; } }

/* anillo de luz que gira en el botón redondo de cada tarjeta */
.go::before {
  content: ''; position: absolute; inset: -2px; border-radius: 50%; padding: 2px;
  background: conic-gradient(from 0deg, #8ddaff, #2b5dff 30%, transparent 45%, var(--red) 62%, transparent 80%, #8ddaff);
  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
  -webkit-mask-composite: xor; mask-composite: exclude;
  animation: spin 5s linear infinite; pointer-events: none;
}

/* Piso brillante con reflejo bajo las tarjetas */
.floor {
  position: absolute; left: 50%; bottom: -46px; width: 110%; height: 150px;
  transform: translateX(-50%); pointer-events: none; z-index: 0;
  background: radial-gradient(ellipse 45% 55% at 50% 30%, rgba(90, 170, 255, .3), transparent 70%);
}
.floor::before, .floor::after {
  content: ''; position: absolute; left: 50%; top: 18%;
  border-radius: 50%; border: 1px solid rgba(160, 215, 255, .35);
  transform: translateX(-50%);
  animation: ring 6s ease-in-out infinite;
}
.floor::before { width: 70%; height: 60%; }
.floor::after  { width: 92%; height: 90%; border-color: rgba(230, 160, 220, .22); animation-delay: -3s; }

/* Puntos indicadores */
.dots { display: flex; gap: 6px; justify-content: center; margin-top: 16px; flex-wrap: wrap; }
.dots button {
  position: relative; overflow: hidden; cursor: pointer;
  padding: 9px 16px 12px; border: 0; border-radius: 999px; background: transparent;
  font-size: 11px; letter-spacing: .24em; text-transform: uppercase; color: #86a9cb;
  transition: color .3s, background .3s, box-shadow .3s;
}
.dots button:hover { color: #fff; }
.dots button[aria-current="true"] { color: #fff; background: rgba(141, 218, 255, .1); box-shadow: inset 0 0 0 1px rgba(141, 218, 255, .35), 0 0 18px rgba(80, 170, 255, .2); }
/* barrita que se llena mientras llega el siguiente giro automático */
.dots button[aria-current="true"]::after { content: ''; position: absolute; left: 16px; right: 16px; bottom: 5px; height: 2px; border-radius: 2px; background: linear-gradient(90deg, #8ddaff, #2b5dff 70%, var(--red)); box-shadow: 0 0 8px rgba(141, 218, 255, .8); transform-origin: left; transform: scaleX(1); }
.dots button.timing::after { animation: fillDot 6s linear both; }

.scroll-cue { margin-top: 14px; font-size: 11px; letter-spacing: .42em; color: #91b8dc; text-decoration: none; display: flex; flex-direction: column; align-items: center; gap: 4px; }
.scroll-cue span { font-size: 16px; letter-spacing: 0; animation: bob 1.8s ease-in-out infinite; }
.scroll-cue:hover { color: var(--cyan); }

/* =========================================================
   BOTONES
   ========================================================= */
.btn {
  display: inline-flex; align-items: center; gap: 8px;
  border: 1px solid rgba(224, 244, 255, .72); background: rgba(2, 20, 48, .35);
  color: #fff; border-radius: 999px; padding: 12px 20px;
  font-size: 11px; letter-spacing: .16em; text-decoration: none; cursor: pointer;
  transition: transform .25s, background .25s, box-shadow .25s;
}
.btn span { font-size: 17px; line-height: 1; }
.btn, .buy, .step { position: relative; overflow: hidden; isolation: isolate; }
/* efecto magnético: el botón se acerca un poco al cursor */
.btn, .go { translate: var(--mx, 0px) var(--my, 0px); transition: transform .25s, background .25s, box-shadow .25s, translate .35s cubic-bezier(.2, .8, .2, 1); }
.magnet { transition: transform .25s, background .25s, box-shadow .25s, translate .12s linear; }
/* onda de luz al hacer clic */
.ripple {
  position: absolute; z-index: 5; border-radius: 50%; pointer-events: none;
  background: radial-gradient(circle, rgba(190, 235, 255, .55), rgba(141, 218, 255, .18) 40%, transparent 70%);
  transform: scale(0); animation: ripple .7s cubic-bezier(.2, .8, .2, 1) forwards;
}
.btn.ghost { border-color: rgba(224, 244, 255, .35); background: transparent; }
.btn.small { padding: 9px 14px; font-size: 10px; }
.btn.primary {
  border-color: transparent;
  background: linear-gradient(120deg, #2b6dff, #4fb4ff 55%, #8ddaff);
  color: #fff; font-weight: 600;
  box-shadow: 0 0 22px rgba(80, 170, 255, .45), inset 0 1px 0 rgba(255, 255, 255, .35);
}
@media (hover: hover) { .btn.primary:hover { background: linear-gradient(120deg, #3a78ff, #63bfff 55%, #a6e3ff); box-shadow: 0 0 30px rgba(80, 170, 255, .65), 0 0 50px rgba(255, 59, 92, .18); } }
.ico { width: 18px; height: 18px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.text-link { font-size: 12px; color: var(--cyan); text-decoration: none; margin-top: 8px; }
.text-link:hover { text-decoration: underline; }

/* Dirección con botón "Cómo llegar" */
.place {
  display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
  margin-top: 22px; padding: 14px 16px; max-width: 560px;
  border-radius: 16px; background: rgba(4, 18, 44, .55); border: 1px solid rgba(160, 215, 255, .22);
  -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
}
.place .ico { width: 26px; height: 26px; color: var(--cyan); filter: drop-shadow(0 0 6px rgba(141, 218, 255, .6)); }
.place div { flex: 1 1 220px; display: flex; flex-direction: column; gap: 2px; }
.place strong { font-size: 13px; letter-spacing: .04em; color: #fff; }
.place span { font-size: 13px; line-height: 1.5; color: var(--soft); }

/* Pasos de reserva (Rehabilitación) */
.steps-title { margin: 26px 0 10px !important; font-size: 11px !important; letter-spacing: .32em; color: var(--cyan) !important; }
.steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; max-width: 560px; }
.step {
  position: relative; display: flex; align-items: center; gap: 14px; padding: 12px 16px;
  border-radius: 16px; text-decoration: none; color: #fff;
  background: rgba(4, 18, 44, .55); border: 1px solid rgba(160, 215, 255, .22);
  transition: transform .3s cubic-bezier(.2, .8, .2, 1), box-shadow .3s, border-color .3s, background .3s;
}
.step .n {
  width: 34px; height: 34px; flex: none; border-radius: 50%; display: grid; place-items: center;
  font-weight: 700; font-size: 14px; border: 1.5px solid rgba(160, 215, 255, .5); color: var(--cyan);
}
.step .st { flex: 1; display: flex; flex-direction: column; gap: 2px; }
.step b { font-size: 14px; font-weight: 600; letter-spacing: .02em; }
.step small { font-size: 12px; color: var(--muted); }
.step .arr { color: var(--cyan); font-size: 18px; transition: transform .3s; }
@media (hover: hover) { .step:hover { transform: translateX(4px); border-color: rgba(141, 218, 255, .6); } .step:hover .arr { transform: translateX(4px); } }
/* paso que toca hacer ahora: brilla */
.step.current { border-color: rgba(141, 218, 255, .75); box-shadow: 0 0 22px rgba(80, 170, 255, .4), 0 0 44px rgba(255, 59, 92, .12); background: rgba(20, 60, 130, .45); }
.step.current .n { background: linear-gradient(135deg, #2b6dff, #8ddaff); color: #fff; border-color: transparent; box-shadow: 0 0 14px rgba(141, 218, 255, .8); animation: pulse 2s ease-in-out infinite; }
/* paso ya hecho */
.step.done .n { background: rgba(80, 200, 140, .2); border-color: rgba(110, 230, 170, .7); color: #7ff0b8; font-size: 0; }
.step.done .n::after { content: '✓'; font-size: 16px; }
.step.done b { color: #cfe9dc; }

/* Botones de compra en Bienestar */
.buy-row { display: flex; flex-wrap: wrap; gap: 10px; margin: 0 0 24px; max-width: 560px; }
.buy {
  flex: 1 1 150px; display: flex; flex-direction: column; gap: 2px; padding: 12px 14px;
  border-radius: 14px; text-decoration: none; color: #fff;
  background: rgba(4, 18, 44, .55); border: 1px solid rgba(160, 215, 255, .25);
  transition: transform .3s cubic-bezier(.2, .8, .2, 1), box-shadow .3s, border-color .3s;
}
.buy b { font-size: 13px; font-weight: 600; }
.buy span { white-space: nowrap; font-size: 18px; font-weight: 700; color: var(--cyan); font-variant-numeric: tabular-nums; }
.buy span::after { content: ' MXN · Comprar →'; font-size: 11px; font-weight: 500; color: var(--muted); letter-spacing: .04em; }
@media (hover: hover) { .buy:hover { transform: translateY(-3px); border-color: rgba(141, 218, 255, .7); box-shadow: 0 0 24px rgba(80, 170, 255, .4), 0 0 40px rgba(255, 59, 92, .15); } }

/* Formulario de asesoría (Estrategia) */
.asesoria {
  padding: 22px; border-radius: 20px;
  background: linear-gradient(160deg, rgba(20, 60, 130, .45), rgba(4, 18, 44, .6));
  border: 1px solid rgba(141, 218, 255, .35); box-shadow: 0 0 30px rgba(80, 170, 255, .18);
}
.form-title { margin: 0 0 14px !important; font-family: 'Playfair Display', serif; font-size: 24px; color: #fff !important; }
.fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; margin-bottom: 16px; }
.fields label { display: flex; flex-direction: column; gap: 6px; font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--muted); }
.fields input, .fields select {
  font: inherit; font-size: 15px; letter-spacing: normal; text-transform: none; color: #fff;
  padding: 12px 14px; border-radius: 12px; border: 1px solid rgba(160, 215, 255, .3);
  background: rgba(1, 8, 22, .6); outline: none; transition: border-color .25s, box-shadow .25s;
}
.fields select option { background: #041430; color: #fff; }
.fields input::placeholder { color: #6f8fb0; }
.fields input:focus, .fields select:focus { border-color: var(--cyan); box-shadow: 0 0 0 3px rgba(141, 218, 255, .2), 0 0 20px rgba(80, 170, 255, .35); }
.form-error { margin: -4px 0 12px !important; font-size: 13px; color: #ff8fa3 !important; }
.asesoria .fine { margin: 12px 0 0 !important; font-size: 12px; color: var(--muted) !important; }
.btn .ig { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; }
.btn .ig circle:last-child { fill: currentColor; stroke: none; }
@media (hover: hover) {
  .btn:hover { transform: translateX(4px); background: rgba(95, 193, 255, .16); box-shadow: 0 0 22px rgba(90, 180, 255, .35); }
}

/* =========================================================
   ANIMACIÓN AL BAJAR (las activa script.js)
   ========================================================= */
.reveal {
  opacity: 0; transform: translateY(40px);
  transition: opacity .9s ease, transform .9s cubic-bezier(.2, .7, .2, 1);
  transition-delay: calc(var(--d, 0) * 110ms);
}
.in .reveal { opacity: 1; transform: none; }

/* =========================================================
   2. SECCIONES DESTACADAS
   ========================================================= */
.feature {
  width: min(1240px, 92vw); margin: 0 auto; padding: 14vh 0 4vh;
  display: grid; column-gap: 6vw; row-gap: 36px; align-items: center;
  grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
  grid-template-areas: "head head" "media text";
  scroll-margin-top: 20px;
}
.feature.reverse {
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
  grid-template-areas: "head head" "text media";
}
.feature-head { grid-area: head; }
.feature.reverse .feature-head { text-align: right; }
.feature-media { grid-area: media; }
.feature-text { grid-area: text; }
.feature .big { font-size: clamp(48px, 8.4vw, 150px); margin: 8px 0 0; }
.feature-media { order: 2; }
.feature-media {
  position: relative; aspect-ratio: 4 / 3; border-radius: 36px; overflow: hidden;
  -webkit-mask-image: var(--feather); mask-image: var(--feather);
  -webkit-mask-composite: source-in; mask-composite: intersect;
  clip-path: inset(0 100% 0 0 round 26px);
  transition: clip-path 1.3s cubic-bezier(.7, 0, .2, 1);
}
.feature.reverse .feature-media { clip-path: inset(0 0 0 100% round 26px); }
.feature.in .feature-media { clip-path: inset(0 0 0 0 round 26px); }
.feature-media img {
  display: block; width: 100%; height: 100%; object-fit: cover;
  transform: scale(1.25); transition: transform 2s cubic-bezier(.2, .7, .2, 1);
}
.feature.in .feature-media img { transform: scale(1.14); }
.feature-media img, .about-photo img { translate: 0 var(--iy, 0px); }
.feature-media::after {
  content: ''; position: absolute; inset: 0; pointer-events: none;
  background: linear-gradient(135deg, rgba(40, 110, 255, .2), transparent 55%), linear-gradient(to top, rgba(2, 10, 30, .45), transparent 45%);
}

.big {
  font-family: Manrope, system-ui, sans-serif; font-weight: 800;
  font-size: clamp(44px, 6.4vw, 104px); line-height: 1; letter-spacing: -.02em;
  margin: 14px 0 18px; padding-top: .1em;
  background: linear-gradient(180deg, #ffffff 30%, #9fd4ff);
  -webkit-background-clip: text; background-clip: text; color: transparent;
}
.feature-text p { color: var(--soft); line-height: 1.7; font-size: 16px; margin: 0 0 18px; max-width: 520px; }
.feature-text .fine { font-size: 12px; color: var(--muted); margin-top: 22px; }
.chips { list-style: none; padding: 0; margin: 0 0 26px; display: flex; flex-wrap: wrap; gap: 8px; max-width: 540px; }
.chips li { font-size: 12px; letter-spacing: .06em; padding: 7px 13px; border-radius: 999px; border: 1px solid rgba(160, 215, 255, .3); background: rgba(255, 255, 255, .04); color: #dcecff; }
.actions { display: flex; flex-wrap: wrap; gap: 12px; }

/* =========================================================
   HERRAMIENTAS (calculadora, mapa del cuerpo, test)
   ========================================================= */
.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
button.text-link { background: none; border: 0; padding: 0; cursor: pointer; font: inherit; font-size: 13px; color: var(--cyan); text-align: left; }
.tool { width: min(1240px, 92vw); margin: 0 auto; padding: 10vh 0 4vh; scroll-margin-top: 80px; }
.tool-head { text-align: center; margin-bottom: 30px; }
.tool-title { margin: 10px 0 8px; font-family: 'Playfair Display', serif; font-size: clamp(30px, 3.6vw, 52px); line-height: 1.1; text-wrap: balance; }
.tool-sub { margin: 0; color: var(--soft); font-size: 16px; }
.tool .fine { font-size: 12px; color: var(--muted); line-height: 1.5; margin: 12px 0 0; }

/* ---- 1. Calculadora ---- */
.calc { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: 28px; padding: 30px; }
.calc { border-radius: 26px; border: 1px solid rgba(141, 218, 255, .28); background: linear-gradient(160deg, rgba(14, 44, 100, .55), rgba(3, 12, 32, .75)); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); box-shadow: 0 20px 60px rgba(0, 0, 0, .4), 0 0 40px rgba(80, 170, 255, .12); }
.calc-controls { display: flex; flex-direction: column; gap: 22px; }
.range { display: flex; flex-direction: column; gap: 10px; }
.range-top { display: flex; justify-content: space-between; align-items: baseline; font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }
.range output { font-size: 22px; letter-spacing: 0; text-transform: none; color: #fff; font-weight: 700; font-variant-numeric: tabular-nums; }
.range input { -webkit-appearance: none; appearance: none; width: 100%; height: 6px; border-radius: 6px; background: linear-gradient(90deg, #3f8ce8, #8ddaff); outline: none; cursor: pointer; }
.range input::-webkit-slider-thumb { -webkit-appearance: none; width: 24px; height: 24px; border-radius: 50%; background: #fff; border: 3px solid #3f8ce8; box-shadow: 0 0 0 5px rgba(141, 218, 255, .2), 0 0 16px rgba(141, 218, 255, .8); cursor: grab; }
.range input::-moz-range-thumb { width: 20px; height: 20px; border-radius: 50%; background: #fff; border: 3px solid #3f8ce8; box-shadow: 0 0 16px rgba(141, 218, 255, .8); cursor: grab; }
.range input:focus-visible { box-shadow: 0 0 0 3px rgba(141, 218, 255, .35); }
.calc-results { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.calc-results div { padding: 14px 16px; border-radius: 16px; background: rgba(1, 8, 22, .5); border: 1px solid rgba(141, 218, 255, .2); display: flex; flex-direction: column; gap: 4px; }
.calc-results small { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
.calc-results b { font-size: clamp(20px, 2vw, 28px); font-variant-numeric: tabular-nums; color: #fff; }
.calc-results .gold { border-color: rgba(232, 198, 122, .45); box-shadow: 0 0 22px rgba(232, 198, 122, .15); }
.calc-results .gold b { background: linear-gradient(120deg, #fff1c4, #e8c67a 50%, #c9953c); -webkit-background-clip: text; background-clip: text; color: transparent; }
.calc-controls .btn { align-self: flex-start; }
.calc-chart { margin: 0; display: flex; flex-direction: column; gap: 10px; }
.legend { display: flex; gap: 18px; font-size: 12px; color: var(--soft); }
.legend span, .chart-tip span { display: inline-flex; align-items: center; gap: 7px; }
.sw { width: 12px; height: 12px; border-radius: 3px; display: inline-block; flex: none; }
.sw-a { background: #3f8ce8; } .sw-b { background: #a8843a; }
.chart-wrap { position: relative; }
#calc-svg { width: 100%; height: auto; display: block; overflow: visible; }
#calc-svg .grid { stroke: rgba(160, 200, 240, .12); stroke-width: 1; }
#calc-svg .axis { fill: #7f9fbf; font-size: 12px; font-family: Manrope, sans-serif; font-variant-numeric: tabular-nums; }
#calc-svg .area-a { fill: rgba(63, 140, 232, .28); }
#calc-svg .area-b { fill: rgba(168, 132, 58, .22); }
#calc-svg .line-a { fill: none; stroke: #3f8ce8; stroke-width: 2; stroke-linejoin: round; }
#calc-svg .line-b { fill: none; stroke: #a8843a; stroke-width: 2; stroke-linejoin: round; }
#calc-svg .dot-a { fill: #3f8ce8; stroke: #061634; stroke-width: 2; }
#calc-svg .dot-b { fill: #a8843a; stroke: #061634; stroke-width: 2; }
#calc-svg .lbl { fill: #fff; font-size: 13px; font-weight: 700; font-family: Manrope, sans-serif; font-variant-numeric: tabular-nums; }
#calc-svg .lbl.muted { fill: #a9c8e6; font-weight: 600; }
#calc-svg .cross { stroke: rgba(220, 236, 255, .5); stroke-width: 1; stroke-dasharray: 3 3; pointer-events: none; }
#calc-svg .hit { fill: transparent; cursor: crosshair; }
.chart-tip { position: absolute; top: -6px; pointer-events: none; display: flex; flex-direction: column; gap: 4px; padding: 10px 12px; border-radius: 12px; font-size: 12px; color: var(--soft); background: rgba(2, 10, 28, .94); border: 1px solid rgba(141, 218, 255, .3); box-shadow: 0 10px 30px rgba(0, 0, 0, .5); white-space: nowrap; }
.chart-tip b { color: #fff; font-size: 13px; }
.chart-tip strong { color: #fff; font-variant-numeric: tabular-nums; margin-left: 4px; }

/* ---- Constelación de las tres áreas ---- */
.constellation { width: min(1000px, 92vw); margin: 0 auto; padding: 12vh 0 2vh; text-align: center; }
.constellation .mini { margin-bottom: 4px; }
.const-wrap { position: relative; width: 100%; aspect-ratio: 800 / 520; margin-top: 10px; }
.const-wrap svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
.cstar { fill: #cfe8ff; opacity: .35; animation: cTwinkle 3.5s ease-in-out infinite; animation-delay: var(--t); }
.edge { fill: none; stroke-width: 2; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; opacity: .85;
  filter: drop-shadow(0 0 6px rgba(141, 218, 255, .6));
  transition: stroke-dashoffset 1.6s cubic-bezier(.6, 0, .2, 1), opacity .35s, stroke-width .35s; transition-delay: calc(var(--o) * .45s), 0s, 0s; }
.constellation.in .edge { stroke-dashoffset: 0; }
.estar { fill: #fff; opacity: 0; filter: drop-shadow(0 0 5px #bfe3ff); transition: opacity .5s; transition-delay: var(--d); }
.constellation.in .estar { opacity: .9; animation: cTwinkle 2.6s ease-in-out infinite; animation-delay: calc(var(--d) + 1.5s); }
.comet { fill: #fff; filter: drop-shadow(0 0 8px #fff) drop-shadow(0 0 16px #8ddaff); opacity: 0; transition: opacity 1s 2s; }
.constellation.in .comet { opacity: 1; }
/* al señalar una estrella, se iluminan sus dos líneas */
.const-wrap[data-hl] .edge { opacity: .2; }
.const-wrap[data-hl="strategy"] .e-strategy, .const-wrap[data-hl="rehab"] .e-rehab, .const-wrap[data-hl="wellness"] .e-wellness { opacity: 1; stroke-width: 3.5; }
.const-wrap[data-hl] .estar { opacity: .2; }
.const-wrap[data-hl="strategy"] .estar.e-strategy, .const-wrap[data-hl="rehab"] .estar.e-rehab, .const-wrap[data-hl="wellness"] .estar.e-wellness { opacity: 1; }
.node { --c: #4f9bff; position: absolute; translate: -50% -50%; z-index: 2; display: flex; flex-direction: column; align-items: center; gap: 4px;
  padding: 8px 12px; border: 0; background: none; color: #fff; cursor: pointer; font: inherit; }
.n-rehab { --c: #ff5a78; } .n-wellness { --c: #e8c67a; }
.node i { order: 0; width: 22px; height: 22px; border-radius: 50%; background: radial-gradient(circle, #fff 0 25%, var(--c) 55%, transparent 72%);
  box-shadow: 0 0 18px var(--c), 0 0 40px var(--c); position: relative; transition: transform .35s; }
.node i::after { content: ''; position: absolute; inset: -10px; border-radius: 50%; border: 1px solid var(--c); opacity: .6; animation: spotPulse 2.4s ease-out infinite; }
.node span { font-family: 'Playfair Display', serif; font-size: clamp(18px, 2.1vw, 28px); font-weight: 700; text-shadow: 0 2px 16px rgba(0, 0, 0, .7); }
.node small { font-size: 12px; letter-spacing: .08em; color: var(--soft); }
.n-strategy { flex-direction: column-reverse; translate: -50% calc(-100% + 11px); }
.n-strategy i { order: 0; }
.n-rehab, .n-wellness { translate: -50% -11px; }
.node:hover i, .node:focus-visible i { transform: scale(1.35); }
.node:hover span, .node:focus-visible span { color: var(--c); }
.const-center { position: absolute; left: 50%; top: 64%; translate: -50% -50%; margin: 0; width: 42%; font-size: 14px; line-height: 1.5; color: var(--muted); letter-spacing: .04em; }
@keyframes cTwinkle { 50% { opacity: .15; } }

/* ---- Bienvenida ---- */
.splash { position: fixed; inset: 0; z-index: 100; display: grid; place-items: center; background: radial-gradient(ellipse at center, #0a2a66 0%, #01060f 70%); cursor: pointer; transition: opacity .5s ease, visibility .5s; }
.splash.out { opacity: 0; visibility: hidden; }
.splash-stars { position: absolute; inset: 0; opacity: .8;
  background-image: radial-gradient(circle at 12% 22%, #fff 0 1px, transparent 2px), radial-gradient(circle at 28% 74%, #bfe3ff 0 1px, transparent 2px), radial-gradient(circle at 44% 16%, #fff 0 1.3px, transparent 2px), radial-gradient(circle at 62% 82%, #fff 0 1px, transparent 2px), radial-gradient(circle at 78% 30%, #e8c67a 0 1.2px, transparent 2px), radial-gradient(circle at 90% 64%, #fff 0 1px, transparent 2px), radial-gradient(circle at 54% 48%, #bfe3ff 0 .8px, transparent 1.5px), radial-gradient(circle at 8% 58%, #fff 0 .8px, transparent 1.5px);
  animation: splashZoom 1.8s ease-out both; }
.splash-logo { position: relative; width: clamp(110px, 16vw, 190px); height: auto;
  filter: drop-shadow(0 0 30px rgba(232, 198, 122, .6)) drop-shadow(0 0 60px rgba(232, 198, 122, .3));
  animation: logoIn 1.1s cubic-bezier(.2, .8, .2, 1) both; }
@keyframes splashZoom { from { transform: scale(1.3); opacity: 0; } to { transform: scale(1); opacity: .8; } }
@keyframes logoIn { 0% { opacity: 0; transform: scale(.85); filter: blur(8px) drop-shadow(0 0 0 rgba(232, 198, 122, 0)); } 60% { opacity: 1; filter: blur(0) drop-shadow(0 0 50px rgba(232, 198, 122, .9)); } 100% { opacity: 1; transform: scale(1); } }
@keyframes eq { 0%, 100% { transform: scaleY(.3); } 50% { transform: scaleY(1); } }
@keyframes litPop { 50% { transform: scale(1.35); } }
.real-q { margin: 8px 0 0; font-family: 'Playfair Display', serif; font-size: clamp(22px, 2.2vw, 30px); line-height: 1.25; color: #fff; }
.real-answers { display: flex; flex-wrap: wrap; gap: 8px; }
.ans { cursor: pointer; padding: 11px 16px; border-radius: 999px; font: inherit; font-size: 14px; color: #fff; background: rgba(255, 255, 255, .05); border: 1px solid rgba(141, 218, 255, .35); transition: background .25s, border-color .25s, box-shadow .25s; }
.ans:hover { background: rgba(63, 140, 232, .2); }
.ans.on { background: rgba(63, 140, 232, .35); border-color: var(--cyan); box-shadow: 0 0 18px rgba(80, 170, 255, .4); }
.ans-reply { margin: 0; min-height: 1.5em; font-size: 15px; line-height: 1.6; color: var(--soft); }
.ans-reply .text-link { font-size: 15px; font-weight: 600; }
.source { margin: 18px 0 0; text-align: center; font-size: 11px; line-height: 1.5; color: #7090b0; }

/* ---- Constelación familiar ---- */
.fami { padding: 28px; border-radius: 26px; border: 1px solid rgba(141, 218, 255, .25); background: linear-gradient(160deg, rgba(14, 44, 100, .45), rgba(3, 12, 32, .8)); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); box-shadow: 0 20px 60px rgba(0, 0, 0, .4); }
.fami-form { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
.fami-form input, .fami-form select { font: inherit; font-size: 15px; color: #fff; padding: 12px 14px; border-radius: 12px; border: 1px solid rgba(160, 215, 255, .3); background: rgba(1, 8, 22, .6); outline: none; }
.fami-form input { flex: 1 1 200px; max-width: 280px; }
.fami-form select option { background: #041430; }
.fami-form input:focus, .fami-form select:focus { border-color: var(--cyan); box-shadow: 0 0 0 3px rgba(141, 218, 255, .2); }
.fami-sky { position: relative; margin-top: 10px; }
#famiSvg { width: 100%; height: auto; display: block; overflow: visible; }
.flink { stroke-width: 1.8; opacity: .75; filter: drop-shadow(0 0 5px currentColor); }
.flink.new { stroke-dasharray: 300; stroke-dashoffset: 300; animation: drawLink .9s ease-out forwards; }
.fring { stroke: rgba(141, 218, 255, .25); stroke-width: 1; stroke-dasharray: 3 5; }
.fme-glow { fill: url(#gCore); fill: rgba(141, 218, 255, .2); animation: mePulse 2.6s ease-in-out infinite; transform-origin: 350px 190px; }
.fme-core { fill: #fff; filter: drop-shadow(0 0 8px #8ddaff) drop-shadow(0 0 18px #8ddaff); }
.flabel { fill: #fff; font: 700 15px Manrope, sans-serif; text-anchor: middle; }
.flabel.me { font: 700 14px Manrope, sans-serif; fill: #bfe3ff; letter-spacing: .2em; }
.frole { fill: #8fb0cf; font: 500 11px Manrope, sans-serif; text-anchor: middle; letter-spacing: .08em; }
.fstar > circle:nth-child(2) { filter: drop-shadow(0 0 8px var(--c)); }
.fstar.new { animation: starIn .6s cubic-bezier(.2, .8, .2, 1) both; transform-box: fill-box; transform-origin: center; }
.fdel { cursor: pointer; opacity: 0; transition: opacity .2s; }
.fdel circle { fill: rgba(255, 90, 120, .85); }
.fdel text { fill: #fff; font: 700 12px Manrope, sans-serif; text-anchor: middle; }
.fstar:hover .fdel, .fdel:focus { opacity: 1; }
@media (hover: none) { .fdel { opacity: .8; } }
.fami-msg { margin: 6px 0 0; text-align: center; font-size: 16px; color: var(--soft); }
.fami-msg b { color: #fff; }
.fami-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; margin-top: 10px; }
.fami-foot .fine { margin: 0; }
@keyframes drawLink { to { stroke-dashoffset: 0; } }
@keyframes starIn { from { opacity: 0; transform: scale(.2); } }
@keyframes mePulse { 50% { transform: scale(1.25); opacity: .6; } }

/* ---- Escenario sin / con seguro ---- */
.scenario { margin-top: 22px; padding: 26px; border-radius: 26px; border: 1px solid rgba(255, 90, 120, .3); background: linear-gradient(160deg, rgba(60, 14, 30, .35), rgba(3, 12, 32, .8)); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); transition: border-color .5s, background .5s, box-shadow .5s; }
.scenario[data-sc="con"] { border-color: rgba(232, 198, 122, .5); background: linear-gradient(160deg, rgba(70, 55, 20, .35), rgba(3, 12, 32, .8)); box-shadow: 0 0 40px rgba(232, 198, 122, .15); }
.seg { position: relative; display: inline-grid; grid-template-columns: 1fr 1fr; padding: 4px; border-radius: 999px; background: rgba(1, 8, 22, .6); border: 1px solid rgba(160, 215, 255, .25); }
.seg-btn { position: relative; z-index: 1; cursor: pointer; padding: 10px 22px; border: 0; background: none; font: inherit; font-size: 13px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: #8fb0cf; transition: color .3s; }
.seg-btn[aria-selected="true"] { color: #fff; }
.seg-glow { position: absolute; z-index: 0; top: 4px; bottom: 4px; left: 4px; width: calc(50% - 4px); border-radius: 999px; background: linear-gradient(120deg, #b0304f, #ff5a78); box-shadow: 0 0 18px rgba(255, 90, 120, .5); transition: transform .45s cubic-bezier(.2, .8, .2, 1), background .45s, box-shadow .45s; }
.scenario[data-sc="con"] .seg-glow { transform: translateX(100%); background: linear-gradient(120deg, #c9953c, #f6e3a1); box-shadow: 0 0 18px rgba(232, 198, 122, .6); }
.scenario[data-sc="con"] .seg-btn[aria-selected="true"] { color: #1a1305; }
.sc-lead { margin: 18px 0 14px; font-family: 'Playfair Display', serif; font-size: clamp(20px, 2vw, 28px); color: #fff; }
.timeline { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; counter-reset: t; }
.timeline li { position: relative; padding: 18px 16px 16px; border-radius: 18px; background: rgba(255, 255, 255, .04); border: 1px solid rgba(255, 140, 160, .25); display: flex; flex-direction: column; gap: 6px; animation: rise .5s cubic-bezier(.2, .8, .2, 1) both; animation-delay: calc(var(--i) * 90ms); }
.timeline li::before { content: ''; position: absolute; left: 16px; top: -5px; width: 10px; height: 10px; border-radius: 50%; background: #ff5a78; box-shadow: 0 0 10px #ff5a78; }
.timeline b { font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: #ff8fa3; }
.timeline span { font-size: 15px; line-height: 1.5; color: #e3f0ff; }
.scenario[data-sc="con"] .timeline li { border-color: rgba(232, 198, 122, .35); background: rgba(232, 198, 122, .06); }
.scenario[data-sc="con"] .timeline li::before { background: #e8c67a; box-shadow: 0 0 10px #e8c67a; }
.scenario[data-sc="con"] .timeline b { color: #e8c67a; }

/* ---- Mitos vs realidad ---- */
.myths { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; perspective: 1400px; }
.myth { position: relative; min-height: 240px; padding: 0; border: 0; background: none; cursor: pointer; font: inherit; color: #fff; transform-style: preserve-3d; transition: transform .7s cubic-bezier(.2, .8, .2, 1); }
.myth.flipped { transform: rotateY(180deg); }
.myth-face { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; gap: 12px; padding: 22px; border-radius: 20px; text-align: left; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
.myth-face small { font-size: 11px; letter-spacing: .32em; font-weight: 700; }
.m-front { background: linear-gradient(160deg, rgba(90, 20, 40, .55), rgba(3, 12, 32, .85)); border: 1px solid rgba(255, 90, 120, .4); }
.m-front small { color: #ff8fa3; }
.m-front b { font-family: 'Playfair Display', serif; font-size: clamp(22px, 2vw, 28px); line-height: 1.2; }
.m-front em { font-style: normal; font-size: 12px; color: var(--muted); margin-top: auto; }
.m-back { transform: rotateY(180deg); background: linear-gradient(160deg, rgba(14, 50, 110, .75), rgba(3, 12, 32, .9)); border: 1px solid rgba(141, 218, 255, .5); box-shadow: 0 0 26px rgba(80, 170, 255, .25); }
.m-back small { color: #8ddaff; }
.m-back span { font-size: 15px; line-height: 1.55; color: #e3f0ff; }
.myth:hover .m-front { box-shadow: 0 0 22px rgba(255, 90, 120, .3); }
.myths-cta { text-align: center; margin: 22px 0 0; }

/* ---- Toque personal: nota de Carlos y disponibilidad ---- */
.reveal.in { opacity: 1; transform: none; }
.cnote { display: flex; gap: 12px; align-items: flex-start; padding: 12px 14px; border-radius: 16px 16px 16px 4px; background: rgba(141, 218, 255, .08); border: 1px solid rgba(141, 218, 255, .25); animation: rise .45s cubic-bezier(.2, .8, .2, 1) both; }
.cnote img { width: 38px; height: 38px; flex: none; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 2px rgba(141, 218, 255, .6), 0 0 14px rgba(80, 170, 255, .45); }
.cnote p { margin: 0 !important; font-size: 14px; line-height: 1.55; color: #e3f0ff !important; }
.cnote b { color: #fff; }
.zone-card .cnote, .quiz-result .cnote { margin: 4px 0 14px; }
#calc-note, #fam-note { min-height: 0; }
.avail { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: var(--soft); }
.avail::before { content: ''; width: 9px; height: 9px; border-radius: 50%; background: #e8c67a; box-shadow: 0 0 8px #e8c67a; }
.avail.on { color: #b7f5d3; }
.avail.on::before { background: #3ddc84; box-shadow: 0 0 10px #3ddc84; animation: spotPulse 2s ease-out infinite; }
.bot-head small.off::before { background: #e8c67a; box-shadow: 0 0 6px #e8c67a; }
.bot-orb.photo { background: none; overflow: visible; }
.bot-orb.photo::after { display: none; }
.bot-orb.photo img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; display: block; }

/* ---- Sobre mí: mi historia ---- */
.story { width: min(1180px, 92vw); margin: 0 auto; padding: 10vh 0 4vh; scroll-margin-top: 70px; display: flex; flex-direction: column; gap: 34px; }
.story-top { width: 100%; padding: 0; }
.story-intro .big { margin: 8px 0 10px; }
.story-lead { font-family: 'Playfair Display', serif; font-size: clamp(20px, 2vw, 28px); color: #fff !important; margin: 0 0 22px !important; }
.story-line { list-style: none; margin: 0; padding: 0 0 0 26px; position: relative; display: grid; gap: 18px; }
.story-line::before { content: ''; position: absolute; left: 6px; top: 6px; bottom: 6px; width: 2px; background: linear-gradient(180deg, #ff5a78, #4f9bff 70%, #e8c67a); border-radius: 2px; opacity: .7; }
.story-line li { position: relative; display: flex; flex-direction: column; gap: 3px; }
.story-line li::before { content: ''; position: absolute; left: -26px; top: 4px; width: 14px; height: 14px; border-radius: 50%; background: #061634; border: 2px solid #8ddaff; box-shadow: 0 0 10px rgba(141, 218, 255, .6); }
.story-line b { font-size: 12px; letter-spacing: .24em; text-transform: uppercase; color: #8ddaff; }
.story-line span { font-size: 16px; line-height: 1.55; color: var(--soft); }
.story-line li.now::before { background: #e8c67a; border-color: #fff1c4; box-shadow: 0 0 16px #e8c67a; }
.story-line li.now b { color: #e8c67a; }
.story-line li.now span { color: #fff; font-weight: 600; }
.why { display: flex; flex-direction: column; gap: 6px; padding: 18px 20px; border-radius: 18px; text-decoration: none; color: #fff; background: rgba(3, 12, 32, .6); border: 1px solid color-mix(in srgb, var(--c) 45%, transparent); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); transition: transform .3s, box-shadow .3s; }
.why b { font-family: 'Playfair Display', serif; font-size: 22px; color: var(--c); }
.why span { font-size: 14px; line-height: 1.55; color: var(--soft); }
.why:hover { transform: translateY(-3px); box-shadow: 0 0 26px color-mix(in srgb, var(--c) 35%, transparent); }
.value { display: flex; flex-direction: column; gap: 6px; padding: 18px 20px; border-top: 1px solid rgba(141, 218, 255, .35); }
.value i { font-style: normal; font-size: 12px; letter-spacing: .2em; color: #8ddaff; }
.value b { font-size: 22px; font-weight: 800; }
.value span { font-size: 14px; line-height: 1.55; color: var(--soft); }
.tell { padding: 26px; border-radius: 26px; border: 1px solid rgba(232, 198, 122, .35); background: linear-gradient(160deg, rgba(60, 48, 20, .3), rgba(3, 12, 32, .8)); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); box-shadow: 0 0 40px rgba(232, 198, 122, .1); display: flex; flex-direction: column; gap: 16px; }
.tell-head { display: flex; gap: 16px; align-items: center; }
.tell-av { width: 64px; height: 64px; flex: none; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 2px #e8c67a, 0 0 22px rgba(232, 198, 122, .5); }
.tell-q { margin: 0 0 4px; font-family: 'Playfair Display', serif; font-size: clamp(22px, 2.2vw, 30px); color: #fff; }
.tell-sub { margin: 0; font-size: 14px; line-height: 1.55; color: var(--soft); }
.tell-opts { display: flex; flex-wrap: wrap; gap: 8px; }
.tell-form label { display: block; font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; }
.tell-row { display: flex; flex-wrap: wrap; gap: 10px; }
.tell-row input { flex: 1 1 220px; font: inherit; font-size: 15px; color: #fff; padding: 12px 14px; border-radius: 12px; border: 1px solid rgba(232, 198, 122, .4); background: rgba(1, 8, 22, .6); outline: none; }
.tell-row input:focus { border-color: #e8c67a; box-shadow: 0 0 0 3px rgba(232, 198, 122, .2); }
.tell-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding-top: 6px; border-top: 1px solid rgba(232, 198, 122, .15); }

/* ---- Conóceme en 30 segundos ---- */
.meet { text-align: center; }
.meet-row { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; margin-top: 14px; text-align: left; }
.meet-card { display: flex; flex-direction: column; gap: 6px; padding: 18px; border-radius: 18px; background: rgba(3, 12, 32, .6); border: 1px solid color-mix(in srgb, var(--c) 40%, transparent); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); transition: transform .3s, box-shadow .3s; }
.meet-card:hover { transform: translateY(-4px); box-shadow: 0 0 24px color-mix(in srgb, var(--c) 35%, transparent); }
.meet-card i { font-style: normal; font-size: 12px; letter-spacing: .2em; color: var(--c); }
.meet-card b { font-size: 16px; }
.meet-card span { font-size: 14px; line-height: 1.5; color: var(--soft); }
.snav-hi { padding: 0 10px 0 4px; font-size: 12px; font-weight: 700; color: #e8c67a; white-space: nowrap; }
.calc-tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin: -10px 0 18px; }
.calc-tabs [role="tab"] { cursor: pointer; padding: 11px 18px; border-radius: 999px; font: inherit; font-size: 14px; color: #cfe4f7; background: rgba(3, 12, 32, .6); border: 1px solid rgba(141, 218, 255, .3); transition: background .25s, box-shadow .25s, color .25s; }
.calc-tabs [role="tab"][aria-selected="true"] { color: #fff; background: linear-gradient(120deg, #2b6dff, #4fb4ff); border-color: transparent; box-shadow: 0 0 20px rgba(80, 170, 255, .45); }
#panel-retiro { margin-top: 0; }

/* ---- Menú organizado ---- */
.mega { position: fixed; inset: 0; z-index: 40; }
.mega-backdrop { position: absolute; inset: 0; background: rgba(0, 6, 18, .7); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); opacity: 0; transition: opacity .3s; }
.mega-panel { position: absolute; top: calc(16px + env(safe-area-inset-top, 0px)); right: 16px; width: min(760px, calc(100vw - 32px)); max-height: calc(100vh - 32px); overflow: auto;
  padding: 22px 24px 24px; border-radius: 24px; border: 1px solid rgba(141, 218, 255, .3);
  background: linear-gradient(170deg, rgba(10, 32, 76, .97), rgba(2, 10, 28, .98)); box-shadow: 0 30px 80px rgba(0, 0, 0, .6);
  transform: translateY(-12px) scale(.98); opacity: 0; transform-origin: top right; transition: transform .35s cubic-bezier(.2, .8, .2, 1), opacity .3s; }
.mega.in .mega-backdrop { opacity: 1; }
.mega.in .mega-panel { transform: none; opacity: 1; }
.mega-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
.mega-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 22px; }
.mega-col { display: flex; flex-direction: column; gap: 2px; padding-left: 14px; border-left: 2px solid var(--c); }
.mega-col b { font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: var(--c); margin-bottom: 6px; }
.mega-col a { display: flex; align-items: center; gap: 10px; padding: 8px 10px; margin-left: -10px; border-radius: 10px; font-size: 15px; color: #e3f0ff; text-decoration: none; transition: background .2s; }
.mega-col a:hover, .mega-col a:focus-visible { background: rgba(141, 218, 255, .1); color: #fff; }
.mega-col a i { font-style: normal; width: 22px; height: 22px; flex: none; display: grid; place-items: center; border-radius: 50%; font-size: 11px; font-weight: 700; color: #04122c; background: var(--c); }
.mega-wa { margin-top: 20px; }
.snav-menu { border: 0; background: none; color: #cfe4f7; font-size: 18px; width: 36px; height: 36px; border-radius: 50%; cursor: pointer; }
.snav-menu:hover { background: rgba(141, 218, 255, .12); color: #fff; }

/* ---- Índice de cada sección y etiqueta "Interactivo" ---- */
.sec-index { width: min(1240px, 92vw); margin: 6vh auto 0; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 14px 18px; border-radius: 18px; background: rgba(3, 12, 32, .55); border: 1px solid color-mix(in srgb, var(--c) 35%, transparent); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }
.sec-index span { font-size: 11px; letter-spacing: .24em; text-transform: uppercase; color: var(--c); margin-right: 6px; }
.sec-index a { padding: 8px 14px; border-radius: 999px; font-size: 13px; color: #e3f0ff; text-decoration: none; border: 1px solid color-mix(in srgb, var(--c) 40%, transparent); transition: background .2s; }
.sec-index a:hover { background: color-mix(in srgb, var(--c) 20%, transparent); }
.tag { display: inline-block; margin-left: 10px; padding: 3px 10px; border-radius: 999px; font-size: 10px; letter-spacing: .18em; font-weight: 700; color: #04122c; background: linear-gradient(120deg, #8ddaff, #e8c67a); vertical-align: middle; }

/* ---- Así trabajo contigo ---- */
.how-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; position: relative; }
.how-steps li { display: flex; flex-direction: column; gap: 6px; padding: 20px; border-radius: 18px; background: rgba(3, 12, 32, .6); border: 1px solid rgba(141, 218, 255, .22); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }
.how-steps i { font-style: normal; width: 34px; height: 34px; display: grid; place-items: center; border-radius: 50%; font-weight: 800; background: linear-gradient(135deg, #2b6dff, #8ddaff); box-shadow: 0 0 14px rgba(141, 218, 255, .6); margin-bottom: 6px; }
.how-steps b { font-size: 17px; }
.how-steps span { font-size: 14px; line-height: 1.55; color: var(--soft); }
.promises { margin-top: 26px; padding: 24px 26px; border-radius: 22px; border: 1px solid rgba(232, 198, 122, .35); background: linear-gradient(160deg, rgba(60, 48, 20, .3), rgba(3, 12, 32, .75)); }
.promises ul { list-style: none; margin: 12px 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px 24px; }
.promises li { position: relative; padding-left: 28px; font-size: 15px; line-height: 1.5; color: #e3f0ff; }
.promises li::before { content: '✓'; position: absolute; left: 0; top: 1px; width: 19px; height: 19px; border-radius: 50%; display: grid; place-items: center; font-size: 11px; font-weight: 800; color: #1a1305; background: #e8c67a; }
.promises li.big-promise { grid-column: 1 / -1; font-family: 'Playfair Display', serif; font-size: clamp(18px, 1.8vw, 24px); color: #fff; padding-top: 10px; border-top: 1px solid rgba(232, 198, 122, .2); }
.promises li.big-promise::before { top: 14px; }
.closing { margin-top: 34px; display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center; }
.closing-av { width: 84px; height: 84px; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 2px #8ddaff, 0 0 30px rgba(80, 170, 255, .55); }
.closing-q { margin: 0; font-family: 'Playfair Display', serif; font-size: clamp(30px, 3vw, 44px); }
.closing .actions { justify-content: center; }

/* ---- Calculadora de protección familiar ---- */
.stepper { display: flex; align-items: center; gap: 12px; }
.stepper button { width: 40px; height: 40px; flex: none; border-radius: 12px; cursor: pointer; font: inherit; font-size: 22px; line-height: 1; color: #fff; background: rgba(1, 8, 22, .5); border: 1px solid rgba(141, 218, 255, .35); transition: background .25s, box-shadow .25s; }
.stepper button:hover:not(:disabled) { background: rgba(63, 140, 232, .3); box-shadow: 0 0 16px rgba(80, 170, 255, .4); }
.stepper button:disabled { opacity: .35; cursor: default; }
.kids { flex: 1; min-height: 40px; display: flex; align-items: center; justify-content: center; gap: 8px; border-radius: 12px; background: rgba(1, 8, 22, .35); border: 1px dashed rgba(141, 218, 255, .25); }
.kids span { color: var(--muted); }
.kids i { width: 18px; height: 28px; position: relative; animation: rise .35s cubic-bezier(.2, .8, .2, 1) both; }
.kids i::before { content: ''; position: absolute; left: 4px; top: 0; width: 10px; height: 10px; border-radius: 50%; background: #a8843a; box-shadow: 0 0 8px rgba(232, 198, 122, .7); }
.kids i::after { content: ''; position: absolute; left: 0; bottom: 0; width: 18px; height: 15px; border-radius: 9px 9px 3px 3px; background: #a8843a; }
.fam-result { position: relative; display: flex; flex-direction: column; gap: 12px; justify-content: center; }
.fam-total { margin: 0; font-size: clamp(38px, 4.4vw, 62px); font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; background: linear-gradient(120deg, #ffffff, #bfe3ff 50%, #8ddaff); -webkit-background-clip: text; background-clip: text; color: transparent; filter: drop-shadow(0 0 20px rgba(80, 170, 255, .35)); }
.fam-bar { display: flex; gap: 2px; height: 22px; border-radius: 4px; overflow: hidden; background: rgba(160, 200, 240, .08); margin-top: 6px; }
.fam-bar span { min-width: 4px; transition: flex .45s cubic-bezier(.2, .8, .2, 1); cursor: default; }
.fam-bar span:hover { filter: brightness(1.2); }
.fam-legend { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
.fam-legend li { display: grid; grid-template-columns: 12px 1fr auto; align-items: center; gap: 10px; font-size: 14px; color: var(--soft); }
.fam-legend b { color: #fff; font-variant-numeric: tabular-nums; }
.fam-less { margin: 0; font-size: 13px; color: #8fe0b8; }
.fam-result .btn { align-self: flex-start; margin-top: 6px; }

/* ---- Asistente virtual ---- */
.bot-fab {
  position: fixed; z-index: 26; right: 22px; bottom: calc(22px + env(safe-area-inset-bottom, 0px));
  width: 64px; height: 64px; padding: 0; border: 0; border-radius: 50%; cursor: pointer; background: none;
  display: grid; place-items: center;
}
.bot-orb {
  width: 64px; height: 64px; border-radius: 50%; display: block; position: relative;
  background: radial-gradient(circle at 35% 30%, #d6f1ff, #4fb4ff 35%, #2b5dff 65%, #0b1f5c);
  box-shadow: 0 0 22px rgba(80, 170, 255, .6), 0 10px 30px rgba(0, 0, 0, .45);
  animation: orbFloat 4s ease-in-out infinite;
}
.bot-orb::before { content: ''; position: absolute; inset: -5px; border-radius: 50%; padding: 2px; background: conic-gradient(#8ddaff, transparent 40%, var(--red) 65%, transparent 85%, #8ddaff); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; animation: spin 4s linear infinite; }
.bot-orb::after { content: ''; position: absolute; left: 50%; top: 50%; width: 22px; height: 8px; margin: -2px 0 0 -11px; border-radius: 4px; background: radial-gradient(circle at 25% 50%, #fff 0 3px, transparent 3.5px), radial-gradient(circle at 75% 50%, #fff 0 3px, transparent 3.5px); animation: blink 5s infinite; }
.bot-orb.small { width: 34px; height: 34px; flex: none; animation: none; }
.bot-orb.small::before { inset: -3px; }
.bot-orb.small::after { width: 14px; height: 6px; margin: -2px 0 0 -7px; background: radial-gradient(circle at 25% 50%, #fff 0 2px, transparent 2.5px), radial-gradient(circle at 75% 50%, #fff 0 2px, transparent 2.5px); }
.bot-fab.open .bot-orb { transform: scale(.9); }
.bot-teaser {
  position: absolute; right: 70px; top: 50%; translate: 0 -50%; white-space: nowrap;
  padding: 10px 14px; border-radius: 14px 14px 4px 14px; font-size: 13px; font-weight: 600; color: #fff;
  background: rgba(8, 28, 66, .95); border: 1px solid rgba(141, 218, 255, .4); box-shadow: 0 10px 30px rgba(0, 0, 0, .45);
  opacity: 0; transform: translateX(10px); pointer-events: none; transition: opacity .4s, transform .4s;
}
.bot-teaser.show { opacity: 1; transform: none; }
.bot {
  position: fixed; z-index: 27; right: 22px; bottom: calc(100px + env(safe-area-inset-bottom, 0px));
  width: min(380px, calc(100vw - 32px)); height: min(560px, calc(100vh - 200px));
  display: flex; flex-direction: column; overflow: hidden;
  border-radius: 24px; border: 1px solid rgba(141, 218, 255, .3);
  background: linear-gradient(170deg, rgba(10, 32, 76, .97), rgba(2, 10, 28, .98));
  box-shadow: 0 30px 80px rgba(0, 0, 0, .6), 0 0 40px rgba(80, 170, 255, .2);
  transform-origin: bottom right; transform: translateY(20px) scale(.92); opacity: 0;
  transition: transform .35s cubic-bezier(.2, .8, .2, 1), opacity .3s;
}
.bot.in { transform: none; opacity: 1; }
.bot-head { display: flex; align-items: center; gap: 12px; padding: 14px 14px 14px 16px; border-bottom: 1px solid rgba(141, 218, 255, .15); background: rgba(20, 60, 130, .25); }
.bot-head div { flex: 1; display: flex; flex-direction: column; }
.bot-head b { font-size: 15px; }
.bot-head small { font-size: 12px; color: #8fe0b8; }
.bot-head small::before { content: ''; display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #3ddc84; margin-right: 6px; box-shadow: 0 0 6px #3ddc84; }
.bot-icon { width: 34px; height: 34px; border: 0; border-radius: 50%; cursor: pointer; font-size: 20px; color: #fff; background: rgba(255, 255, 255, .06); }
.bot-icon:hover { background: rgba(255, 255, 255, .14); }
.bot-log { flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: 16px; display: flex; flex-direction: column; gap: 10px; }
.msg { max-width: 86%; padding: 10px 14px; border-radius: 16px; font-size: 14px; line-height: 1.5; animation: rise .35s cubic-bezier(.2, .8, .2, 1) both; }
.bot-msg { align-self: flex-start; background: rgba(255, 255, 255, .07); border: 1px solid rgba(141, 218, 255, .15); border-bottom-left-radius: 4px; color: #e3f0ff; }
.me-msg { align-self: flex-end; background: linear-gradient(120deg, #2b6dff, #4fb4ff); color: #fff; border-bottom-right-radius: 4px; }
.msg blockquote { margin: 8px 0 0; padding: 8px 10px; border-left: 3px solid #8ddaff; border-radius: 0 8px 8px 0; background: rgba(1, 8, 22, .45); font-size: 13px; color: var(--soft); }
.msg-actions { display: flex; flex-direction: column; gap: 8px; }
.msg-actions .btn { justify-content: center; }
.typing { display: flex; gap: 4px; padding: 14px; }
.typing i { width: 7px; height: 7px; border-radius: 50%; background: #8ddaff; animation: typing 1s infinite; }
.typing i:nth-child(2) { animation-delay: .15s; } .typing i:nth-child(3) { animation-delay: .3s; }
.bot-opts { display: flex; flex-wrap: wrap; gap: 8px; padding: 0 16px 12px; }
.bot-opts:empty { display: none; }
.bopt { cursor: pointer; padding: 9px 14px; border-radius: 999px; font: inherit; font-size: 13px; color: #fff; background: rgba(63, 140, 232, .14); border: 1px solid rgba(141, 218, 255, .45); transition: background .2s, box-shadow .2s, transform .2s; animation: rise .35s cubic-bezier(.2, .8, .2, 1) both; }
.bopt:hover { background: rgba(63, 140, 232, .32); box-shadow: 0 0 14px rgba(80, 170, 255, .4); transform: translateY(-1px); }
.bopt.ghost { background: transparent; border-color: rgba(141, 218, 255, .25); color: var(--soft); }
.bot-input { display: flex; gap: 8px; padding: 12px 16px 16px; border-top: 1px solid rgba(141, 218, 255, .12); }
.bot-input input { flex: 1; min-width: 0; font: inherit; font-size: 15px; color: #fff; padding: 11px 14px; border-radius: 12px; border: 1px solid rgba(141, 218, 255, .3); background: rgba(1, 8, 22, .6); outline: none; }
.bot-input input:focus { border-color: var(--cyan); box-shadow: 0 0 0 3px rgba(141, 218, 255, .2); }
.bot-input button { width: 44px; border: 0; border-radius: 12px; cursor: pointer; font-size: 18px; color: #fff; background: linear-gradient(120deg, #2b6dff, #4fb4ff); }
html.modal-open .bot-fab, html.modal-open .bot { opacity: 0; pointer-events: none; }
/* Insignia de WhatsApp sobre la foto del asistente (un solo botón) */
.wa-badge { position: absolute; right: -4px; bottom: -4px; width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; background: linear-gradient(135deg, #25d366, #128c4a); box-shadow: 0 0 0 2px #061634, 0 0 12px rgba(37, 211, 102, .7); }
.wa-badge::after { content: ''; position: absolute; inset: 0; border-radius: 50%; border: 2px solid rgba(37, 211, 102, .6); animation: badgePulse 2.6s ease-out infinite; pointer-events: none; }
@keyframes badgePulse { from { transform: scale(1); opacity: .9; } 70%, to { transform: scale(1.9); opacity: 0; } }
.wa-badge svg { width: 15px; height: 15px; fill: none; stroke: #fff; stroke-width: 1.8; stroke-linejoin: round; }
.wa-badge svg .fill { fill: #fff; stroke: none; }
.bot-fab.open .wa-badge { opacity: 0; transform: scale(.6); transition: opacity .25s, transform .25s; }
/* Acceso directo a WhatsApp dentro del asistente */
.bot-direct { display: flex; align-items: center; gap: 10px; margin: 12px 16px 0; padding: 10px 14px; border-radius: 14px; text-decoration: none; color: #dff7e8; font-size: 13px; background: rgba(37, 211, 102, .12); border: 1px solid rgba(37, 211, 102, .45); transition: background .25s, box-shadow .25s; }
.bot-direct svg { width: 20px; height: 20px; flex: none; fill: none; stroke: #3ddc84; stroke-width: 1.8; }
.bot-direct span { flex: 1; }
.bot-direct b { color: #fff; }
.bot-direct i { font-style: normal; color: #3ddc84; }
.bot-direct:hover { background: rgba(37, 211, 102, .22); box-shadow: 0 0 16px rgba(37, 211, 102, .3); }
@keyframes orbFloat { 50% { transform: translateY(-4px); } }
@keyframes blink { 0%, 92%, 100% { transform: scaleY(1); } 95% { transform: scaleY(.1); } }
@keyframes typing { 0%, 60%, 100% { opacity: .3; transform: translateY(0); } 30% { opacity: 1; transform: translateY(-3px); } }

/* ---- 2. Mapa del cuerpo ---- */
.bodymap { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 34px; align-items: center; padding: 30px; border-radius: 26px; border: 1px solid rgba(255, 90, 120, .25); background: linear-gradient(160deg, rgba(60, 20, 50, .35), rgba(3, 12, 32, .78)); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); box-shadow: 0 20px 60px rgba(0, 0, 0, .4), 0 0 40px rgba(255, 70, 110, .1); }
.body-figure { position: relative; width: min(260px, 100%); margin: 0 auto; aspect-ratio: 200 / 430; }
#body-svg { position: absolute; inset: 0; width: 100%; height: 100%; }
.silhouette > * { fill: url(#bodyGrad); stroke: rgba(141, 218, 255, .55); stroke-width: 1.2; }
.silhouette .joint { fill: rgba(141, 218, 255, .22); stroke: rgba(141, 218, 255, .85); stroke-width: 1.4; filter: drop-shadow(0 0 3px rgba(141, 218, 255, .6)); }
.scan { stroke: rgba(141, 218, 255, .8); stroke-width: 1.5; filter: drop-shadow(0 0 4px #8ddaff); animation: bodyScan 4s ease-in-out infinite; }
.hotspots { position: absolute; inset: 0; }
.spot {
  position: absolute; width: 26px; height: 26px; margin: -13px 0 0 -13px; padding: 0; border-radius: 50%; cursor: pointer;
  border: 2px solid #ff5a78; background: rgba(255, 90, 120, .25);
  box-shadow: 0 0 12px rgba(255, 90, 120, .7); transition: transform .25s, background .25s;
}
.spot::after { content: ''; position: absolute; inset: -8px; border-radius: 50%; border: 1px solid rgba(255, 90, 120, .6); animation: spotPulse 2.2s ease-out infinite; }
.spot:hover, .spot:focus-visible { transform: scale(1.25); }
.spot.on { background: #ff5a78; transform: scale(1.3); box-shadow: 0 0 22px #ff5a78, 0 0 44px rgba(255, 90, 120, .5); }
.zone-info { min-height: 320px; display: flex; align-items: center; }
.zone-empty { width: 100%; }
.zone-hint { margin: 0 0 14px; font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: var(--muted); }
.zone-chips { display: flex; flex-wrap: wrap; gap: 8px; }
.zchip { cursor: pointer; padding: 10px 16px; border-radius: 999px; font: inherit; font-size: 14px; color: #fff; background: rgba(255, 255, 255, .05); border: 1px solid rgba(255, 140, 160, .35); transition: background .25s, border-color .25s, box-shadow .25s; }
.zchip:hover, .zchip.on { background: rgba(255, 90, 120, .2); border-color: #ff5a78; box-shadow: 0 0 16px rgba(255, 90, 120, .35); }
.zone-card { width: 100%; animation: rise .5s cubic-bezier(.2, .8, .2, 1) both; }
.zone-card h3 { margin: 6px 0 8px; font-family: 'Playfair Display', serif; font-size: clamp(30px, 3vw, 44px); }
.zone-card > p { color: var(--soft); line-height: 1.6; margin: 0 0 14px; max-width: 520px; }
.zone-lbl { font-size: 11px !important; letter-spacing: .28em; text-transform: uppercase; color: #ff8fa3 !important; margin-bottom: 8px !important; }
.zone-tx { list-style: none; margin: 0 0 6px; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
.zone-tx li { padding: 8px 14px; border-radius: 999px; font-size: 13px; background: rgba(255, 90, 120, .12); border: 1px solid rgba(255, 90, 120, .4); }
.zone-card .actions { margin: 18px 0 12px; }

/* ---- 3. Test de Immunocal ---- */
.quiz { max-width: 820px; margin: 0 auto; padding: 32px; border-radius: 26px; border: 1px solid rgba(232, 198, 122, .3); background: linear-gradient(160deg, rgba(70, 55, 20, .3), rgba(3, 12, 32, .8)); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); box-shadow: 0 20px 60px rgba(0, 0, 0, .4), 0 0 40px rgba(232, 198, 122, .1); }
.quiz-card { animation: rise .5s cubic-bezier(.2, .8, .2, 1) both; }
.quiz-card h3 { margin: 8px 0 20px; font-family: 'Playfair Display', serif; font-size: clamp(26px, 2.6vw, 38px); }
.quiz-progress { display: flex; gap: 6px; margin-bottom: 18px; }
.quiz-progress i { flex: 1; height: 4px; border-radius: 4px; background: rgba(232, 198, 122, .18); }
.quiz-progress i.done { background: #c9953c; }
.quiz-progress i.cur { background: linear-gradient(90deg, #c9953c, #fff1c4); box-shadow: 0 0 10px rgba(232, 198, 122, .7); }
.quiz-opts { display: grid; gap: 10px; margin-bottom: 16px; }
.qopt { display: flex; align-items: center; gap: 14px; width: 100%; padding: 16px 18px; border-radius: 16px; cursor: pointer; text-align: left; font: inherit; font-size: 16px; color: #fff; background: rgba(255, 255, 255, .04); border: 1px solid rgba(232, 198, 122, .28); transition: transform .25s, background .25s, border-color .25s, box-shadow .25s; }
.qopt:hover { transform: translateX(4px); border-color: #e8c67a; background: rgba(232, 198, 122, .08); }
.qopt.picked { background: rgba(232, 198, 122, .2); border-color: #e8c67a; box-shadow: 0 0 22px rgba(232, 198, 122, .35); }
.qk { width: 30px; height: 30px; flex: none; display: grid; place-items: center; border-radius: 9px; font-weight: 700; font-size: 13px; color: #e8c67a; border: 1px solid rgba(232, 198, 122, .5); }
.qopt.picked .qk { background: #e8c67a; color: #1a1305; }
.quiz-result { display: grid; grid-template-columns: 220px 1fr; gap: 28px; align-items: center; }
.quiz-result img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; object-position: 50% 58%; border-radius: 18px; background: #eef0f2; box-shadow: 0 0 0 1px rgba(232, 198, 122, .4), 0 20px 50px rgba(0, 0, 0, .5), 0 0 40px rgba(232, 198, 122, .2); }
.quiz-result h3 { margin: 2px 0 10px; }
.quiz-result > div > p { color: var(--soft); line-height: 1.6; margin: 0 0 12px; }
.qline { font-size: 11px; letter-spacing: .3em; color: #e8c67a; }
.qprice { font-size: 26px !important; font-weight: 700; color: #fff !important; font-variant-numeric: tabular-nums; }
.qprice span { font-size: 13px; font-weight: 500; color: var(--muted); }
.quiz-result .actions { margin: 6px 0 12px; }

@keyframes bodyScan { 0%, 100% { transform: translateY(20px); opacity: 0; } 15%, 85% { opacity: 1; } 50% { transform: translateY(410px); } }
@keyframes spotPulse { from { transform: scale(.6); opacity: 1; } to { transform: scale(1.6); opacity: 0; } }

/* =========================================================
   3. FRASE GIGANTE (aparece palabra por palabra)
   ========================================================= */
.statement { padding: 18vh 6vw 14vh; text-align: right; overflow: hidden; }
.statement h2 {
  margin: 0; font-family: Manrope, system-ui, sans-serif; font-weight: 800;
  font-size: clamp(64px, 12.5vw, 220px); line-height: .9; letter-spacing: -.035em;
}
.statement span {
  display: block; opacity: 0; transform: translateY(70px); filter: blur(10px);
  transition: opacity 1s ease, transform 1s cubic-bezier(.2, .7, .2, 1), filter 1s ease;
}
.statement span.in { opacity: 1; transform: none; filter: none; }
/* cada palabra empieza en contorno y se llena de luz con el scroll (--f de 0 a 1) */
.statement span {
  color: transparent;
  -webkit-text-stroke: 1.5px rgba(160, 215, 255, calc((1 - var(--f, 0)) * .55));
  background-image: linear-gradient(180deg, #ffffff 30%, #bfe3ff);
  background-repeat: no-repeat;
  background-size: calc(var(--f, 0) * 100%) 100%;
  -webkit-background-clip: text; background-clip: text;
}
.statement .gold {
  -webkit-text-stroke-color: rgba(232, 198, 122, calc((1 - var(--f, 0)) * .6));
  background-image: linear-gradient(120deg, #fff1c4 0%, #e8c67a 30%, #b8862f 55%, #f6e3a1 75%, #c9953c 100%);
}

/* =========================================================
   4. SOBRE MÍ
   ========================================================= */
.about-section {
  width: min(1180px, 92vw); margin: 0 auto; padding: 10vh 0 14vh;
  display: grid; grid-template-columns: .85fr 1.15fr; gap: 6vw; align-items: center;
  scroll-margin-top: 20px;
}
.about-photo {
  border-radius: 36px; overflow: hidden;
  -webkit-mask-image: var(--feather); mask-image: var(--feather);
  -webkit-mask-composite: source-in; mask-composite: intersect;
  opacity: .3; transform: translateY(40px) scale(.96);
  transition: opacity 1.1s ease, transform 1.1s cubic-bezier(.2, .7, .2, 1);
}
.about-section.in .about-photo { opacity: 1; transform: none; }
.about-photo { aspect-ratio: 900 / 846; }   /* tamaño fijo aunque la foto aún no cargue */
.about-photo img { display: block; width: 100%; height: 100%; object-fit: cover; transform: scale(1.12); }

/* =========================================================
   PIE DE PÁGINA
   ========================================================= */
footer {
  display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 8px 18px;
  padding: 26px 16px;
  border-top: 1px solid rgba(190, 226, 255, .18);
  background: rgba(1, 12, 29, .75); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
  font-size: 11px; letter-spacing: .12em;
}
footer a, footer .link { color: #dcecff; text-decoration: none; }
footer .link { background: none; border: 0; padding: 0; cursor: pointer; letter-spacing: inherit; font-size: inherit; }
footer a:hover, footer .link:hover { color: var(--cyan); }
footer strong { font-weight: 500; }

/* =========================================================
   PANEL (MODAL)
   ========================================================= */
.modal { position: fixed; inset: 0; z-index: 30; animation: fade .25s ease; }
.modal[hidden] { display: none; }
.backdrop { position: absolute; inset: 0; background: rgba(0, 6, 18, .8); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }
.panel {
  position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
  width: min(1050px, 92vw); max-height: 86vh; overflow: hidden; display: flex; flex-direction: column;
  border: 1px solid rgba(180, 228, 255, .42); border-radius: 26px;
  background: linear-gradient(145deg, rgba(7, 35, 76, .98), rgba(2, 15, 37, .98));
  box-shadow: 0 35px 110px rgba(0, 0, 0, .65);
  padding: 0; outline: none;
}
/* El contenido es lo que se desplaza; el botón de cerrar queda fijo en la esquina */
#panelContent { overflow: auto; overscroll-behavior: contain; padding: 44px; max-height: 86vh; }
.close { position: absolute; top: 16px; right: 16px; margin: 0; width: 44px; height: 44px; border: 0; border-radius: 50%; background: rgba(2, 12, 30, .55); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); color: #fff; font-size: 28px; line-height: 1; cursor: pointer; z-index: 3; }
.close:hover { background: rgba(255, 255, 255, .14); }
.panel h2 { font-family: 'Playfair Display', serif; font-size: 44px; margin: 6px 0; }
.panel p { color: var(--soft); line-height: 1.65; }
.panel-intro { margin: 0; }
/* Portada del panel con la foto del área */
.panel-hero {
  position: relative; margin: -44px -44px 24px; height: clamp(190px, 34vh, 320px);
  clip-path: inset(0);   /* recorta el zoom sin empujar el botón de cerrar */
}
.panel-hero img {
  display: block; width: 100%; height: 100%; object-fit: cover; animation: heroZoom 9s ease-out both;
  -webkit-mask-image: linear-gradient(to bottom, #000 45%, transparent); mask-image: linear-gradient(to bottom, #000 45%, transparent);
}
.panel-hero-text { position: absolute; left: 44px; bottom: 34px; animation: rise .8s .15s cubic-bezier(.2, .8, .2, 1) both; }
.panel-hero-text h2 { font-size: clamp(40px, 5vw, 64px); text-shadow: 0 6px 30px rgba(0, 0, 0, .7); }
/* Contenido del panel entra en cascada */
.panel .panel-intro, .panel .tile, .panel .section-title, .panel .product, .panel .cta-row, .panel .legal, .panel .note, .panel .privacy {
  animation: rise .65s cubic-bezier(.2, .8, .2, 1) both;
  animation-delay: calc(var(--i, 0) * 70ms + 260ms);
}

.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 15px; margin-top: 22px; }
.tile, .product {
  position: relative; isolation: isolate; overflow: hidden; cursor: pointer;
  border: 1px solid rgba(180, 225, 255, .2); border-radius: 18px; background: rgba(255, 255, 255, .035);
  transition: transform .35s cubic-bezier(.2, .8, .2, 1), box-shadow .35s, border-color .35s;
}
.tile { display: flex; flex-direction: column; padding: 20px; }
/* contorno de luz que gira (aparece al pasar el mouse y queda fijo al seleccionar) */
.tile::before, .product::before {
  content: ''; position: absolute; z-index: -2; left: 50%; top: 50%; width: 180%; aspect-ratio: 1;
  margin: -90% 0 0 -90%;   /* centrado sin usar transform, porque el giro lo usa */
  background: conic-gradient(from 0deg, transparent 0 55%, #8ddaff 68%, #2b5dff 76%, var(--red) 86%, transparent 94%);
  animation: spin 3.2s linear infinite;
  opacity: 0; transition: opacity .35s;
}
.tile::after, .product::after {
  content: ''; position: absolute; z-index: -1; inset: 2px; border-radius: 16px;
  background: linear-gradient(160deg, #0a2550, #041430);
}
@media (hover: hover) {
  .tile:hover, .product:hover { transform: translateY(-3px); border-color: rgba(141, 218, 255, .45); box-shadow: 0 10px 30px rgba(0, 0, 0, .35), 0 0 18px rgba(80, 170, 255, .2); }
  .tile:hover::before, .product:hover::before { opacity: .55; }
}
.tile.selected, .product.selected {
  transform: translateY(-3px); border-color: transparent;
  box-shadow: 0 0 0 1px rgba(141, 218, 255, .75), 0 0 32px rgba(80, 170, 255, .6), 0 0 70px rgba(255, 59, 92, .25);
}
.tile.selected::before, .product.selected::before { opacity: 1; }
.tile.selected strong { color: #bfe8ff; text-shadow: 0 0 14px rgba(141, 218, 255, .6); }
.tile strong { display: block; margin-bottom: 8px; letter-spacing: .04em; }
.tile p { margin: 0; }
.tile ul { margin: 0; padding-left: 18px; color: var(--soft); line-height: 1.6; }
.tile .btn { margin-top: auto; align-self: flex-start; }
.tile p + .btn, .tile ul + .btn { margin-top: 16px; }
.num { display: block; font-size: 11px; letter-spacing: .3em; color: var(--cyan); margin-bottom: 6px; font-weight: 600; }

.section-title { font-size: 15px; letter-spacing: .08em; margin: 34px 0 0; font-weight: 700; }
.products-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 15px; margin-top: 16px; }
.product { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; padding: 14px 14px 18px; }
.product img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: 50% 58%; border-radius: 12px; margin-bottom: 10px; background: #eef0f2; }
.product small { font-size: 10px; letter-spacing: .3em; color: var(--pink); }
.product strong { font-size: 16px; }
.product img.fit { object-position: 50% 50%; }
.product .price { margin-top: auto; padding-top: 6px; }
.product-desc { margin: 2px 0 4px; font-size: 13px; line-height: 1.45; color: var(--muted); }
.products-group { grid-column: 1 / -1; margin: 14px 0 -4px; font-size: 11px; font-weight: 700; letter-spacing: .3em; text-transform: uppercase; color: var(--cyan); }
.ship-note { display: flex; gap: 10px; align-items: flex-start; max-width: 560px; margin: -8px 0 22px; font-size: 13px; line-height: 1.5; color: var(--muted); }
.ship-note b { color: #e8f4ff; font-weight: 600; }
.ship-note svg { flex: 0 0 20px; width: 20px; height: 20px; margin-top: 1px; fill: none; stroke: var(--cyan); stroke-width: 1.6; stroke-linejoin: round; }
.buy-group { flex-basis: 100%; margin: 8px 0 -2px; font-size: 10px; font-weight: 700; letter-spacing: .3em; text-transform: uppercase; color: var(--muted); }
.price { font-size: 20px; font-weight: 700; color: var(--cyan); margin-bottom: 10px; }

.cta-row { margin-top: 26px; }
.note { font-size: 12px; color: var(--muted) !important; margin: 14px 0 0; }
.legal { margin: 24px 0 0; padding: 12px 16px; border-left: 3px solid var(--pink); background: rgba(231, 165, 220, .08); border-radius: 0 10px 10px 0; font-size: 13px; font-weight: 600; color: #f2dcee !important; }
.privacy p { margin: 12px 0 0; }
.privacy strong { color: #fff; }

/* =========================================================
   ANIMACIONES
   ========================================================= */
@keyframes float1 { to { transform: translate(5vw, 2vh) rotate(-7deg); } }
@keyframes float2 { to { transform: translate(-4vw, 2vh) rotate(12deg); } }
@keyframes float3 { to { transform: translate(3vw, -2vh); } }
@keyframes milky { to { transform: rotate(-8deg) translateX(4%) scale(1.06); opacity: .85; } }
@keyframes ring { 0%, 100% { opacity: .35; transform: translateX(-50%) scale(.97); } 50% { opacity: 1; transform: translateX(-50%) scale(1.03); } }
@keyframes shine { 0%, 70% { transform: translateX(-70%); } 100% { transform: translateX(70%); } }
@keyframes bob { 50% { transform: translateY(5px); } }
@keyframes fade { from { opacity: 0; } }
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes ripple { to { transform: scale(1); opacity: 0; } }
@keyframes fillDot { from { transform: scaleX(0); } to { transform: scaleX(1); } }
@keyframes waPulse { 0% { box-shadow: 0 0 0 0 rgba(37, 211, 102, .55), 0 10px 30px rgba(0, 0, 0, .45); } 70% { box-shadow: 0 0 0 18px rgba(37, 211, 102, 0), 0 10px 30px rgba(0, 0, 0, .45); } 100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0), 0 10px 30px rgba(0, 0, 0, .45); } }
@keyframes scan { from { background-position: 0 100%; } to { background-position: 0 0; } }
@keyframes pulse { 50% { box-shadow: 0 0 24px rgba(141, 218, 255, 1), 0 0 40px rgba(255, 59, 92, .35); } }
@keyframes drift { from { transform: scale(1.02) translate(0, 0); } to { transform: scale(1.12) translate(-2%, -1.5%); } }
@keyframes clouds { to { transform: translateX(calc(var(--ch) * -4.8)); } }
@keyframes rise { from { opacity: 0; transform: translateY(26px) scale(.97); filter: blur(4px); } }
@keyframes heroZoom { from { transform: scale(1.18); } to { transform: scale(1.02); } }

/* =========================================================
   COMPUTADORAS CON PANTALLA CHICA (1024–1280px)
   ========================================================= */
@media (max-width: 1200px) {
  .meet-row { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .how-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .myths { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .timeline { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  :root { --card-w: min(64vw, 820px, calc(var(--deck-h) * 1.5)); }
}

