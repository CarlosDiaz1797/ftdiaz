const PAGO_NOMBRES = {
  mx: 'Immunocal MX', platinum: 'Immunocal Platinum', sport: 'Immunocal Sport',
  optimizer: 'Immunocal Optimizer', omega: 'Omega Gen V', bionutric: 'Bionutric',
